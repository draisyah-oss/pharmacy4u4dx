# Copy this file to .env and fill it in. Never commit .env.

# Password for the "admin" login, used the first time the app starts (8+ characters).
ADMIN_PASSWORD=change-me-please

# Leave DATABASE_URL empty on your laptop: the app then uses a built-in local database
# stored in ./data (nothing to install). Railway fills this in automatically.
DATABASE_URL=

# Sales sheet link (optional – see README → Sales sheet). On your laptop point to the key file;
# on Railway paste the whole key file's text into GOOGLE_SERVICE_ACCOUNT_JSON instead.
# GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SALES_SHEET_ID=1VygZxfSWcZpinRkZ_DpGAG92lVFDT3sjbJ-pxH8T0dM   # already in seed.json
# SALES_SHEET_SYNC_MINUTES=10

# Optional
# PORT=3000
# DATABASE_SSL=true   # only if your Postgres provider requires SSL
