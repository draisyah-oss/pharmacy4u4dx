# Copy this file to .env and fill it in. Never commit .env.

# Password for the "admin" login, used the first time the app starts (8+ characters).
ADMIN_PASSWORD=change-me-please

# Leave DATABASE_URL empty on your laptop: the app then uses a built-in local database
# stored in ./data (nothing to install). Railway fills this in automatically.
DATABASE_URL=

# Optional
# PORT=3000
# DATABASE_SSL=true   # only if your Postgres provider requires SSL
