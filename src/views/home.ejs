<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'home' }) %>
<main class="page home">
  <%- include('partials/company-sales', { company }) %>
  <h1>Branches</h1>
  <p class="muted">Month sales per branch, counted to the last closed day. Tap the amount for the daily numbers behind it.</p>
  <div class="pick-list home-branches">
    <% branches.forEach(function (b) {
         const r = company && company.rows ? company.rows.find(function (x) { return x.code === b.code; }) : null; %>
      <div class="pick pick-two">
        <span class="pick-main"><%= b.name %></span>
        <% if (r) { %><%- include('partials/branch-sales', { s: r.sales, started: r.started, asOf: r.asOf, href: r.started ? '/scoreboard/trace?type=sales&from=' + r.sales.month + '-01&to=' + r.asOf + '&branch=' + encodeURIComponent(b.code) : null }) %><% } %>
        <span class="pick-sub"><%= b.today_entries ? b.today_entries + ' of ' + b.fields + ' numbers in today' : 'Nothing in yet today' %></span>
        <span class="pick-links">
          <a class="button secondary small-button" href="/daily?branch=<%= encodeURIComponent(b.code) %>">Daily entry</a>
          <a class="button small-button" href="/scoreboard?branch=<%= encodeURIComponent(b.code) %>">Scoreboard</a>
          <a class="button secondary small-button" href="/weekly?branch=<%= encodeURIComponent(b.code) %>">Check-in</a>
        </span>
      </div>
    <% }) %>
  </div>
  <% if (user.role === 'admin') { %><p class="login-alt"><a class="button" href="/admin">Admin: targets, people, export</a></p><% } %>
</main>
</body>
</html>
