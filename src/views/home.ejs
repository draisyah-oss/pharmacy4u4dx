<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'home' }) %>
<%# 9 Nov redesign: HQ / admin home – Needs you, the company WIG with every branch, the month's goals. News on /news. %>
<link rel="stylesheet" href="/css/home.css?v=2">
<main class="page hd-page">
  <% if (typeof ok !== 'undefined' && ok) { %><p class="alert alert-good"><%= ok %></p><% } %>
  <% if (typeof err !== 'undefined' && err) { %><p class="alert alert-bad"><%= err %></p><% } %>
  <header class="hd-hello">
    <div>
      <p class="hd-date"><%= new Date(hl.today + 'T00:00:00Z').toLocaleDateString('en-GB', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }) %></p>
      <h1><%= hi.greeting %>, <%= hi.name %></h1>
    </div>
    <nav class="hd-actions" aria-label="Quick actions">
      <a class="button secondary" href="/group">Group scoreboard</a>
      <% if (user.role === 'admin') { %><a class="button secondary" href="/admin">Admin</a><% } %>
    </nav>
  </header>
  <%- include('partials/hd-needs') %>
  <%- include('partials/hd-company', { H: hl, branches: branches, links: true }) %>
  <%- include('partials/hd-news-line', { H: hl }) %>
</main>
</body>
</html>
