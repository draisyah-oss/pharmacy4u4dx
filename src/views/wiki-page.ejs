<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'wiki-' + page.section }) %>
<main class="page wi-page<%= page.kind === 'image' || page.kind === 'pdf' ? ' wi-wide' : '' %>">
  <p><a href="/wiki/s/<%= page.section %>">‹ <%= S.name %></a></p>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>
  <article class="oo-card wi-article">
    <header class="wi-article-head">
      <h1><%= page.title %></h1>
      <p class="muted small">
        <%= page.section === 'poster' ? (page.branch_name || 'HQ') + ' · by ' + (page.created_by_name || '–') : 'Updated ' + new Date(page.updated_at).toLocaleDateString('en-GB', { timeZone: 'Asia/Kuala_Lumpur', day: 'numeric', month: 'short', year: 'numeric' }) %>
        <%= page.tags ? ' · ' + page.tags : '' %>
        <% if (staff) { %> · read by <%= page.reads %> of <%= staff %><% } %>
      </p>
      <% if (page.status !== 'published') { %><p class="oo-chip <%= page.status === 'needs_fix' ? 'oc-warn' : 'oc-info' %>"><%= page.status === 'needs_fix' ? 'FIX NEEDED' : 'WAITING FOR APPROVAL' %></p><% } %>
      <% if (page.review_note) { %><p class="oo-note">Hanin: “<%= page.review_note %>”</p><% } %>
    </header>
    <% if (page.kind === 'image') { %><img class="wi-full" src="/wiki/f/<%= page.file_id %>" alt="<%= page.title %>"><% } %>
    <% if (page.kind === 'video') { %><video class="wi-full" src="/wiki/f/<%= page.file_id %>" controls preload="metadata"></video><% } %>
    <%- include('partials/wiki-text', { text: page.body }) %>
    <% if (page.file_id) { %>
      <p class="wi-file"><a class="button secondary" href="/wiki/f/<%= page.file_id %>"><%= page.kind === 'pdf' ? 'Open the PDF' : page.kind === 'office' ? 'Download ' + page.filename : 'Open full size' %></a>
        <span class="muted small"><%= page.filename %> · <%= Math.max(1, Math.round(page.size / 1024)) %> KB</span></p>
    <% } %>
  </article>

  <% if (canReview && page.section === 'poster' && page.status === 'pending') { %>
    <form method="post" action="/wiki/p/<%= page.id %>/review" class="oo-card oo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="oo-label">Note to the branch <small class="muted">(needed for a fix)</small><input name="note" maxlength="500"></label>
      <div class="oo-two"><button class="button" name="decision" value="approve" type="submit">Approve</button><button class="button secondary" name="decision" value="fix" type="submit">Needs a fix</button></div>
    </form>
  <% } %>
  <% if (page.section === 'poster' && page.status === 'needs_fix' && (own || canReview)) { %>
    <form method="post" action="/wiki/p/<%= page.id %>/resend" enctype="multipart/form-data" class="oo-card oo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Fix and send again</h2>
      <label class="oo-label">Topic<input name="title" maxlength="160" value="<%= page.title %>" required></label>
      <label class="oo-label">Caption<textarea name="body" rows="4" maxlength="2200"><%= page.body || '' %></textarea></label>
      <label class="oo-label">New poster (leave empty to keep the old one)<input type="file" name="file" accept="image/*,application/pdf"></label>
      <button class="button wide" type="submit">Send again</button>
    </form>
  <% } %>
  <% if (canEdit) { %>
    <div class="wi-actions">
      <a class="button secondary" href="/wiki/p/<%= page.id %>/edit">Change</a>
      <form method="post" action="/wiki/p/<%= page.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Remove from the wiki</button></form>
    </div>
  <% } %>
</main>
</body>
</html>
