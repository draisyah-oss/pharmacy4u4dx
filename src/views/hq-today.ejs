<%- include('partials/head', { bodyClass: 'daily-body' }) %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'hqtoday' }) %>
<%
  const pq = 'person=' + person.id;
  const off = blocked ? ' disabled' : '';
  const c = check;
  const weekEnd = new Date(Date.parse(week + 'T00:00:00Z') + 6 * 86400000).toISOString().slice(0, 10);
%>
<div class="daybar">
  <% if (people.length > 1) { %>
    <nav class="strip branch-strip" aria-label="Choose a person">
      <% people.forEach(function (p) { %><a href="/hq/today?person=<%= p.id %>&week=<%= week %>" class="strip-pill<%= p.id === person.id ? ' is-current' : '' %>"><%= p.name %></a><% }) %>
    </nav>
  <% } %>
  <nav class="strip" aria-label="Choose a week">
    <% strip.forEach(function (h) { %>
      <a href="/hq/today?<%= pq %>&week=<%= h.week %>" class="strip-day<%= h.week === week ? ' is-current' : '' %><%= h.ticked ? ' has-data' : '' %>"<%- h.week === week ? ' aria-current="date"' : '' %>>
        <span class="strip-dow"><%= h.week === thisWeek ? 'This wk' : 'w/c' %></span>
        <span class="strip-num"><%= fmtDate(h.week, { weekday: undefined }) %></span>
      </a>
    <% }) %>
  </nav>
</div>
<% if (ok) { %><p class="alert alert-good page-flash" role="status"><%= ok %></p><% } %>
<% if (err) { %><p class="alert alert-bad page-flash" role="alert"><%= err %></p><% } %>

<main class="page wk">
  <header class="board-head">
    <h1><%= person.name %> <span class="board-week">weekly check-in · <%= week === thisWeek ? 'this week' : 'week of' %> <%= fmtDate(week, { weekday: undefined }) %> – <%= fmtDate(weekEnd, { weekday: undefined }) %></span></h1>
    <p class="muted"><%= person.role || '' %> · once a week, by Friday: did each of these happen this week? Done, Not done, or N/A if it didn’t apply.</p>
  </header>
  <%- include('partials/month-goals') %>

  <section class="focus-card<%= focus.length ? '' : ' is-empty' %>" aria-label="This week’s focus">
    <span class="wk-k">This week’s focus</span>
    <% if (focus.length) { focus.forEach(function (f) { %>
      <b><%= f.focus %></b>
      <span class="small <%= f.status === 'approved' ? 's-on_track' : 'muted' %>"><%= f.status === 'approved' ? 'Approved by the CEO ✔' : 'Proposed – waiting for the CEO' %></span>
    <% }) } else { %>
      <span class="muted small">Not set yet – set at the Monday 10 am HQ WIG (<a href="/hq/commitments">HQ WIG session</a>).</span>
    <% } %>
  </section>

  <% if (actions.length) { %>
  <section class="wk-card" aria-labelledby="act-h">
    <h2 id="act-h">HQ actions for branches <span class="muted small">agreed at the Monday update</span></h2>
    <% actions.forEach(function (a) { %>
      <form method="post" action="/hq/actions/<%= a.id %>" class="act-last">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/hq/today">
        <span><b><%= a.branch_code || 'HQ' %></b>: <%= a.issue %><%= a.due_date ? ' – by ' + fmtDate(a.due_date) : '' %><% if (a.due_date && a.due_date < today) { %> <b class="s-off_track">late</b><% } %></span>
        <% if (a.canClose) { %><span class="act-btns">
          <button class="yn-btn" name="status" value="Done" type="submit">Done</button>
          <button class="yn-btn" name="status" value="Not done" type="submit">Not done</button>
        </span><% } %>
      </form>
    <% }) %>
  </section>
  <% } %>

  <section class="wk-facts" aria-label="This week">
    <div class="wk-fact">
      <span class="wk-k">Done this week (N/A not counted)</span>
      <span class="wk-v<%= c.pct === null ? '' : c.pct >= 0.95 ? ' s-on_track' : c.pct >= 0.855 ? ' s-watch' : ' s-off_track' %>"><%= c.ticked ? c.done + ' of ' + c.counted : '–' %></span>
      <span class="wk-sub"><%= c.pct === null ? 'Not checked in yet' : fmt.pct(c.pct) + ' · target 95%' + (c.complete ? '' : ' · ' + (c.total - c.ticked) + ' not ticked') %></span>
    </div>
    <div class="wk-fact">
      <span class="wk-k">Last weeks</span>
      <span class="wk-days"><% strip.forEach(function (h) { %><span class="wk-day<%= h.pct === null ? '' : h.pct >= 0.95 ? ' s-on_track' : ' s-off_track' %>" title="w/c <%= fmtDate(h.week) %>: <%= h.done %> of <%= h.counted %>"><%= fmtDate(h.week, { weekday: undefined }) %> <%= h.pct === null ? '–' : Math.round(h.pct * 100) + '%' %></span><% }) %></span>
    </div>
  </section>

  <% if (!tasks.length) { %>
    <section class="wk-card"><p class="muted">No check-in items yet. <%= canManage ? 'Add 3–6 things you should do every week that move your KPIs (below).' : '' %></p></section>
  <% } else { %>
    <form method="post" action="/hq/today" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person" value="<%= person.id %>"><input type="hidden" name="week" value="<%= week %>">
      <% if (blocked) { %><p class="alert alert-info"><%= blocked %></p><% } %>
      <section class="wk-card" aria-label="Weekly check-in">
        <% tasks.forEach(function (t) { const v = !t.tick ? '' : t.tick.na ? 'na' : t.tick.done ? 'yes' : 'no'; %>
          <fieldset class="commit-done">
            <legend><b><%= t.label %></b><% if (t.tick && t.tick.entered_by) { %> <span class="muted small">– <%= t.tick.entered_by %></span><% } %></legend>
            <div class="yesno yesno-3">
              <label class="yn yn-yes"><input type="radio" name="t[k<%= t.id %>]" value="yes"<%= v === 'yes' ? ' checked' : '' %><%= off %>><span>Done</span></label>
              <label class="yn yn-no"><input type="radio" name="t[k<%= t.id %>]" value="no"<%= v === 'no' ? ' checked' : '' %><%= off %>><span>Not done</span></label>
              <label class="yn yn-na"><input type="radio" name="t[k<%= t.id %>]" value="na"<%= v === 'na' ? ' checked' : '' %><%= off %>><span>N/A</span></label>
            </div>
          </fieldset>
        <% }) %>
      </section>
      <% if (!blocked) { %><button class="button wide" type="submit">Save</button><% } %>
    </form>
  <% } %>

  <% if (canManage) { %>
    <details class="wk-card admin-details" id="tasks">
      <summary>Change the check-in list</summary>
      <% tasks.forEach(function (t) { %>
        <form method="post" action="/hq/today/tasks" class="inline-form task-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person" value="<%= person.id %>"><input type="hidden" name="week" value="<%= week %>">
          <input type="hidden" name="retire" value="<%= t.id %>">
          <span><%= t.label %></span> <button class="link-button" type="submit">Remove</button>
        </form>
      <% }) %>
      <form method="post" action="/hq/today/tasks" class="admin-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person" value="<%= person.id %>"><input type="hidden" name="week" value="<%= week %>">
        <label class="wide">New check-in item <input name="label" maxlength="120" placeholder="e.g. POs checked against 30-day sales before placing" required></label>
        <button class="button small-button" type="submit">Add item</button>
      </form>
    </details>
  <% } %>
</main>
</body>
</html>
