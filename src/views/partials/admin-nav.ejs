<%
  const sections = [['/admin', 'Overview'], ['/admin/targets', 'Targets'], ['/admin/people', 'People & logins'], ['/admin/measures', 'Measures'], ['/admin/audit', 'Audit log']];
%>
<nav class="tabs admin-tabs" aria-label="Admin sections">
  <% sections.forEach(function (s) { %>
    <a href="<%= s[0] %>" class="tab<%= active === s[0] ? ' is-current' : '' %>"<%= active === s[0] ? ' aria-current="page"' : '' %>><%= s[1] %></a>
  <% }) %>
</nav>
<% if (typeof ok !== 'undefined' && ok) { %><p class="alert alert-good admin-flash" role="status"><%= ok %></p><% } %>
<% if (typeof err !== 'undefined' && err) { %><p class="alert alert-bad admin-flash" role="alert"><%= err %></p><% } %>
