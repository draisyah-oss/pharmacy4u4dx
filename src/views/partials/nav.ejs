<% if (user && user.role !== 'branch_staff') {
     const here = typeof navActive !== 'undefined' ? navActive : '';
     const many = user.role === 'admin' || user.role === 'hq';
     const bq = many && typeof branch !== 'undefined' && branch ? '?branch=' + encodeURIComponent(branch.code) : '';
     let tabs = [];
     if (user.role === 'hq_staff') {
       // HQ staff: their own KPIs, tasks, commitments, projects + the two scoreboards.
       tabs = [
         ['hq', '/hq', 'My KPIs'], ['hqtoday', '/hq/today', 'My day'], ['hqcommit', '/hq/commitments', 'Commitments'],
         ['projects', '/hq/projects', 'Projects'], ['hqboard', '/hq/scoreboard', 'HQ scoreboard'], ['group', '/group', 'Group'],
         ['sales', '/sales', 'Sales'],
       ];
     } else {
       tabs = [
         ['daily', '/daily' + bq, 'Daily entry'], ['scoreboard', '/scoreboard' + bq, 'Scoreboard'],
         ['weekly', '/weekly' + bq, 'Check-in'], ['commitments', '/commitments' + bq, 'Commitments'], ['group', '/group', 'Group'],
         ['sales', '/sales', 'Sales'],
       ];
       if (many) {
         tabs.push(['hq', '/hq', 'HQ input'], ['hqtoday', '/hq/today', 'HQ day'], ['hqcommit', '/hq/commitments', 'HQ commitments'],
           ['projects', '/hq/projects', 'Projects'], ['hqboard', '/hq/scoreboard', 'HQ scoreboard']);
       }
       if (user.role === 'admin') tabs.push(['admin', '/admin', 'Admin']);
     } %>
  <nav class="tabs" aria-label="Sections">
    <% tabs.forEach(function (t) { %>
      <a href="<%= t[1] %>" class="tab<%= here === t[0] ? ' is-current' : '' %>"<%= here === t[0] ? ' aria-current="page"' : '' %>><%= t[2] %></a>
    <% }) %>
  </nav>
<% } %>
