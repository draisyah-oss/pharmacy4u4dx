<%# Side menu (everyone logged in; branch staff get a short one). Wide screens: fixed on the left, can be hidden
    with «. Phones: slides in from the left via the Menu button in the top bar (works without
    JavaScript – a checkbox drives it). navActive: the current item's key. %>
<% if (user) {
     const here = typeof navActive !== 'undefined' ? navActive : '';
     const role = user.role;
     const many = role === 'admin' || role === 'hq';
     // 3 Nov: zakat claims tracker – BR, WM, JH (their own branch), HQ and admin.
     const zakatHere = ['BR', 'WM', 'JH'].includes(user.branch_code);
     const bq = many && typeof branch !== 'undefined' && branch ? '?branch=' + encodeURIComponent(branch.code) : '';
     // [key, href, label, search words]
     let quick = []; let groups = [];
     // Inventory (19 Oct): out-of-stock inbox + transfers – only the inventory team (Alia, Syarafana, Fariz) and admin.
     const inv = role === 'admin' || Boolean(user.inventory);
     // 3 Nov: Ordering & payments (/inventory) – also for the payments team (Azwani).
     const board = ['inventory', '/inventory', 'Ordering & payments', 'order payment supplier budget cash plan approve paid transfer mr eve daily plan'];
     const inventory = inv ? [['Inventory', [board, ['oosinbox', '/oos/inbox', 'Out-of-stock inbox', 'oos restock answer'],
       ['oostransfers', '/oos/transfers', 'Deliveries to send', 'oos transfer delivery send hq'],
       ['oosactivity', '/oos/activity', 'Activity log', 'oos seen question reply follow up whatsapp'],
       ['oosproducts', '/oos/products', 'Product list (Dynamod)', 'masterlist dynamod stock id barcode upload cost price margin']]]]
       : (user.payments || role === 'hq' || role === 'hq_staff') ? [['Inventory', [board]]] : []; // 4 Nov: all HQ see Ordering & payments
     // Projects (HQ team only), with the wiki checklist as a sub-item (full HQ and admin open it).
     // Milestones with a step checklist (19 Oct, e.g. min/max top 300) are sub-items too, with done / total.
     const stepItems = (typeof stepMenu !== 'undefined' && stepMenu ? stepMenu : []).map(function (m) {
       return ['steps-' + m.id, '/hq/projects/' + m.id + '/steps', m.milestone, 'steps checklist project', 'sub', m.done + '/' + m.total]; });
     const projects = ['Projects', [['projects', '/hq/projects', 'Projects', 'milestones'], ...stepItems,
       ...(role === 'admin' || role === 'hq' ? [['hqwiki', '/hq/wiki', 'Wiki checklist', 'company wiki sop jd policy', 'sub']] : [])]];
     if (role === 'branch_staff') {
       quick = [['daily', '/daily', 'Daily entry'], ['myweek', '/my-week', 'My week']];
       groups = [['Branch', [['daily', '/daily', 'Daily entry', 'log today'], ['scoreboard', '/scoreboard', 'Scoreboard', 'week lead'], ['myweek', '/my-week', 'My week', 'commitment wig'],
         ['oos', '/oos', 'Out of stock', 'oos report restock'], ['month', '/month', 'Month scoreboard', 'monthly summary'],
         ...(zakatHere ? [['zakat', '/zakat', 'Zakat claims', 'zakat claim payment bid contract supplier']] : [])]], ['Company', [['group', '/group', 'Group scoreboard', 'branches']]]];
     } else if (role === 'hq_staff') {
       quick = [['hqtoday', '/hq/today', 'My week'], ['hqcommit', '/hq', 'HQ WIG']];
       groups = [
         ['My work', [['hqtoday', '/hq/today', 'Weekly check-in', 'tasks weekly my week day'],
           ['hqcommit', '/hq', 'HQ WIG session', 'my kpis input numbers weekly commitments focus monday']]],
         ...inventory,
         projects,
         ['Scoreboards', [['hqboard', '/hq/scoreboard', 'HQ scoreboard', 'kpi'], ['group', '/group', 'Group scoreboard', 'branches company'],
           ['sales', '/sales', 'Sales', 'ytd daily year b2b grab zakat'], ['oosboard', '/oos/scoreboard', 'Out-of-stock scoreboard', 'oos restock']]],
       ];
     } else {
       quick = role === 'hq' ? [[inv ? 'oosinbox' : 'hqtoday', inv ? '/oos/inbox' : '/hq/today', inv ? 'Out of stock' : 'Check-in'], ['group', '/group', 'Group'], ['sales', '/sales', 'Sales']]
         : [['daily', '/daily' + bq, 'Daily entry'], ['scoreboard', '/scoreboard' + bq, 'Scoreboard']];
       groups = [
         ['Branch', [['daily', '/daily' + bq, 'Daily entry', 'log today walk-in'], ['scoreboard', '/scoreboard' + bq, 'Scoreboard', 'week lead'],
           ['oos', '/oos' + bq, 'Out of stock', 'oos report restock'],
           ['weekly', '/weekly' + bq, 'Weekly update to HQ', 'monday check-in stock zakat'], ['commitments', '/commitments' + bq, 'Branch WIG session', 'tuesday weekly commitments'],
           ...(role === 'branch_manager' ? [['myweek', '/my-week', 'My week', 'my commitment']] : []),
           ['branchmeasures', '/branch/measures' + bq, 'Branch measures', 'measures targets activity lead change edit approve'],
           ...(zakatHere || many ? [['zakat', '/zakat' + (many && typeof branch !== 'undefined' && branch && ['BR', 'WM', 'JH'].includes(branch.code) ? '?branch=' + branch.code : ''), 'Zakat claims', 'zakat claim payment bid contract supplier']] : [])]],
         ['Company', [['group', '/group', 'Group scoreboard', 'branches'], ['sales', '/sales', 'Sales', 'ytd daily year b2b grab zakat'],
           ['oosboard', '/oos/scoreboard', 'Out-of-stock scoreboard', 'oos restock']]],
       ];
       if (many) {
         groups.push(['HQ', [['hqtoday', '/hq/today', 'HQ weekly check-in', 'tasks weekly day'],
           ['hqcommit', '/hq', 'HQ WIG session', 'hq input kpi numbers b2b weekly commitments focus monday 10am'],
           ['hqupdate', '/hq/update', 'Weekly Branch Manager Meeting', 'managers monday 4pm branches actions update'],
           ['hqboard', '/hq/scoreboard', 'HQ scoreboard', 'kpi']]]);
         groups.push(...inventory, projects);
       }
       if (role === 'admin') {
         quick.push(['/admin', '/admin', 'Admin']);
         groups.push(['Admin', [['/admin', '/admin', 'Overview', 'admin'], ['/admin/targets', '/admin/targets', 'Targets', 'sales month ytd'],
           ['/admin/people', '/admin/people', 'People & logins', 'pin password staff'], ['/admin/measures', '/admin/measures', 'Measures', 'lead'],
           ['/admin/audit', '/admin/audit', 'Audit log', 'history changes'], ['status', '/status', 'Setup check', 'google sheet database']]]);
       }
     }
     // 1 Nov: Monthly Performance Review (first Monday of the month) – managers, HQ, HQ staff, admin.
     if (role !== 'branch_staff') groups.push(['Monthly review', [['month', '/month', 'Month scoreboard', 'monthly summary october improvement notes bring forward department individual'],
       ['review', '/review', 'Monthly review', 'month performance review first monday october november goals conclusion stop start keep'],
       ...(role !== 'hq_staff' ? [['reviewbranch', '/review/branch' + bq, 'Branch review', 'month branch manager plan', 'sub']] : []),
       ...(role !== 'branch_manager' ? [['reviewhq', '/review/hq', 'HQ review', 'month hq', 'sub']] : []),
       ['reviewgoals', '/review/conclusion', 'Month goals', 'conclusion agree lock', 'sub']]]);
     // 6 Nov: Pharmacy4U Academy (trial) – 5 minutes a day of learning, for everyone logged in.
     groups.push(['Academy', [['academy', '/academy', 'Pharmacy4U Academy', 'learn learning training quiz module cards role-play challenge xp'],
  ['academyranks', '/academy/ranks', 'Ranks', 'academy ranks leaderboard badges level streak', 'sub'],
       ...(['branch_manager', 'hq', 'admin'].includes(role) ? [['academymanager', '/academy/manager', 'Who has finished', 'academy manager verify challenge', 'sub']] : [])]]);
     // 6 Nov: invoice scan – everyone scans supplier invoices into the Finance inbox.
     groups.push(['Invoices', [['invoices', '/invoices', 'Invoices', 'invoice scan supplier finance dynamod pdf bill receipt'],
       ['invoicenew', '/invoices/new', 'Scan an invoice', 'invoice scan photo camera supplier', 'sub']]]);
     // 30 Oct: company policies (read only) for everyone, branch staff included.
     groups.push(['Company policies', [['policies', '/policies', 'Policies', 'policy polisi hr leave cuti annual carry forward handbook']]]);
     // 28 Oct: everyone can ask for a change to the app (Mr 4DX builds it, the CEO approves).
     groups.push(['Improve the app', [['requests', '/requests', 'Request a change', 'improve suggest idea bug feature change mr 4dx']]]);
     // 3 Nov (CEO): the menu groups in this order.
     const ORDER = ['Company', 'Scoreboards', 'Branch', 'My work', 'HQ', 'Academy', 'Monthly review', 'Inventory', 'Invoices', 'Company policies', 'Projects', 'Improve the app', 'Admin'];
     const rank = (g) => { const i = ORDER.indexOf(g[0]); return i < 0 ? ORDER.length : i; };
     groups = groups.map(function (g, i) { return [g, i]; }).sort(function (a, b) { return rank(a[0]) - rank(b[0]) || a[1] - b[1]; }).map(function (x) { return x[0]; });
     const count = (n, what) => '<span class="sn-badge" aria-label="' + n + ' ' + what + '">' + n + '</span>';
     const badge = (key) => (key === 'oosinbox' && typeof oosCount !== 'undefined' && oosCount ? count(oosCount, 'to answer')
       : '');
     const sub = role === 'admin' ? (user.is_super ? 'Super admin' : 'Admin') : role === 'hq' || role === 'hq_staff' ? 'HQ' : (user.branch_name || user.branch_code || '');
%>
<input type="checkbox" id="nav-open" class="nav-check" aria-hidden="true" tabindex="-1">
<label for="nav-open" class="nav-backdrop" aria-hidden="true"></label>
<aside class="sidenav" id="sidenav" aria-label="Menu">
  <div class="sn-head">
    <div class="sn-title"><a href="/" class="sn-logo"><img src="/img/wordmark.png" alt="Pharmacy4U" width="134" height="16"><span class="sn-app">4DX</span></a><span><%= sub %></span></div>
    <button type="button" class="sn-collapse" data-nav-collapse aria-label="Hide menu" title="Hide menu">«</button>
    <label for="nav-open" class="sn-close" aria-label="Close menu">✕</label>
  </div>
  <% const nd = typeof needs !== 'undefined' && needs ? needs : null; if (nd) { %>
  <section class="sn-needs" aria-label="Needs you">
    <p class="sn-needs-h">Needs you</p>
    <% if (!nd.items.length) { %><p class="sn-clear">✔ All clear – nothing waiting for you</p><% } %>
    <% nd.items.forEach(function (it) { %>
      <a class="sn-need lv-<%= it.level %>" href="<%= it.href %>"><span class="sn-n"><%= it.count %></span><span><b><%= it.title %></b><small><%= it.sub %></small></span></a>
    <% }) %>
    <% if (nd.more) { %><p class="sn-more muted small">+ <%= nd.more %> more in the menu</p><% } %>
  </section>
  <% } %>
  <%# Fixed for everyone (19 Oct): Daily entry and own branch scoreboard (branch logins), Group scoreboard (all). %>
  <div class="sn-quick">
    <% if (role === 'branch_staff' || role === 'branch_manager') { %>
      <a href="/daily" class="sn-tile<%= here === 'daily' ? ' is-current' : '' %>">Daily entry</a>
      <a href="/scoreboard" class="sn-tile<%= here === 'scoreboard' ? ' is-current' : '' %>"><%= user.branch_code || 'Branch' %> scoreboard</a>
    <% } %>
    <a href="/group" class="sn-tile sn-wide<%= here === 'group' ? ' is-current' : '' %>">Group scoreboard</a>
  </div>
  <input type="search" class="sn-search" data-nav-search placeholder="Search… e.g. sales, OOS" aria-label="Search the menu" hidden>
  <nav>
    <% groups.forEach(function (g) { %>
      <details class="sn-group" open>
        <summary><%= g[0] %></summary>
        <% g[1].forEach(function (l) { %>
          <a href="<%= l[1] %>" class="sn-link<%= l[4] === 'sub' ? ' sn-sub' : '' %><%= here === l[0] ? ' is-current' : '' %>" data-words="<%= (l[2] + ' ' + (l[3] || '')).toLowerCase() %>"<%- here === l[0] ? ' aria-current="page"' : '' %>><%= l[2] %><%- badge(l[0]) %><% if (l[5]) { %><span class="sn-count" aria-label="<%= l[5].replace('/', ' of ') %> steps done"><%= l[5] %></span><% } %></a>
        <% }) %>
      </details>
    <% }) %>
    <p class="sn-none muted" hidden>Nothing matches.</p>
  </nav>
</aside>
<script src="/js/nav.js?v=1" defer></script>
<% } %>
