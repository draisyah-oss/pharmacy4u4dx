<%# Plain text with paragraphs, "- " bullet lists and "# " headings. Everything is escaped. Input: text %>
<% if (text) {
     const blocks = String(text).split(/\n\s*\n/);
     blocks.forEach(function (b) {
       const lines = b.split('\n');
       if (lines.every(function (l) { return /^\s*[-•*]\s+/.test(l); })) { %>
         <ul><% lines.forEach(function (l) { %><li><%= l.replace(/^\s*[-•*]\s+/, '') %></li><% }) %></ul>
<%     } else if (/^#\s+/.test(lines[0])) { %>
         <h3><%= lines[0].replace(/^#\s+/, '') %></h3><% if (lines.length > 1) { %><p class="wk-pre"><%= lines.slice(1).join('\n') %></p><% } %>
<%     } else { %><p class="wk-pre"><%= b %></p><% }
     });
   } %>
