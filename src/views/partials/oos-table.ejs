<%# 28 Oct: every open out-of-stock item on one screen, by branch + B2B, answered in one Save (like
    Alia's OOS spreadsheet). Input: open, branchCodes, typed, rowErrors, today, tomorrow, of, at %>
<%
  const groups = branchCodes.concat(['B2B']).map(function (code) { return { code: code, rows: open.filter(function (it) { return it.branch_code === code; }) }; });
  const ANS = [['', '— choose —'], ['clarify', '❓ Ask branch to clarify'], ['hq_deliver', 'HQ delivers'], ['transfer', 'Transfer from branch'], ['order', 'Order (supplier)'], ['substitute', 'Substitute (until back)'], ['not_stocked', 'Not stocked – offer substitute (closes)'], ['discontinue', 'Discontinue'], ['done', '✔ Done – delivered']];
  const val = function (it, k, dflt) { const t = typed['i' + it.id]; return t && t[k] !== undefined ? t[k] : dflt; };
%>
<p class="muted">Every open item, by branch. Pick an answer, fill the row, then one <b>Save all</b> at the bottom. Not sure what the item is? Choose <b>❓ Ask branch to clarify</b> and type the question in the note – it goes to whoever reported it. Rows you don’t touch stay as they are. Tap an item to ask the branch a question or see photos.</p>
<nav class="strip oo-tabs" aria-label="Jump to a branch">
  <% groups.forEach(function (g) { %><a href="#t-<%= g.code %>" class="strip-pill"><%= g.code %> (<%= g.rows.length %>)</a><% }) %>
</nav>
<form method="post" action="/oos/inbox/table" class="oo-table-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% groups.forEach(function (g) { %>
    <section class="oo-tgroup" id="t-<%= g.code %>" aria-labelledby="h-<%= g.code %>">
      <h2 id="h-<%= g.code %>"><%= g.code === 'B2B' ? 'B2B customers' : g.code %> <span class="muted small">· <%= g.rows.length %> open</span></h2>
      <% if (!g.rows.length) { %><p class="muted small"><%= g.code === 'B2B' ? 'No B2B items – add one below.' : 'Nothing open.' %></p><% } else { %>
      <div class="table-wrap"><table class="oo-table">
        <thead><tr>
          <th>Reported</th><th>Item</th><th>Answer</th><th class="n">Qty</th><th>From</th><th>Arrives by</th><th>Note to branch / substitute / question</th><th>Now</th>
        </tr></thead>
        <tbody>
        <% g.rows.forEach(function (it) { const k = 'r[i' + it.id + ']'; const a = val(it, 'answer', it.answer || ''); const bad = rowErrors[it.id]; %>
          <tr class="<%= it.urgent && it.unanswered ? 'is-urgent' : '' %><%= bad ? ' is-error' : '' %>" data-row>
            <td class="nowrap"><%= of.when(it.reported_at, at) %><br><small class="muted"><%= it.seen_at ? 'seen ' + (it.seen_by_name || '') : 'not opened' %></small></td>
            <td class="oo-titem"><a href="/oos/<%= it.id %>"><b><%= it.item %></b></a><% if (it.urgent && it.unanswered) { %> <span class="oo-chip oc-bad">URGENT</span><% } %>
              <br><small class="muted"><%= it.b2b_customer ? it.b2b_customer + ' · ' : '' %><%= it.left_qty === 0 ? '0 left' : it.left_qty ? it.left_qty + ' left' : '' %><%= it.customers_count ? ' · ' + (it.customers_count >= 3 ? '3+' : '1–2') + ' asking' : '' %><%= it.note ? ' · “' + it.note + '”' : '' %><%= it.photo_id ? ' · 📷' : '' %><%= it.timesThisMonth > 1 ? ' · ' + it.timesThisMonth + '× this month' : '' %></small>
              <% if (it.awaitingHq) { %><br><a class="oo-due s-watch" href="/oos/<%= it.id %>">💬 Branch replied</a><% } else if ((it.messages || []).length) { %><br><a class="small" href="/oos/<%= it.id %>">💬 <%= it.messages.length %></a><% } %>
            </td>
            <td><select name="<%= k %>[answer]" aria-label="Answer for <%= it.item %>" data-answer>
              <% ANS.forEach(function (o) { %><option value="<%= o[0] %>"<%= a === o[0] ? ' selected' : '' %>><%= o[1] %></option><% }) %>
            </select></td>
            <td class="n"><input name="<%= k %>[qty]" inputmode="numeric" class="oo-tqty" value="<%= val(it, 'qty', it.answer_qty || '') %>" aria-label="Quantity" autocomplete="off"></td>
            <td><select name="<%= k %>[from]" aria-label="From which branch" data-from>
              <% const fromNow = val(it, 'from', it.answer === 'hq_deliver' ? 'HQ' : (it.from_code || '')); %>
              <option value="">–</option>
              <option value="HQ"<%= fromNow === 'HQ' ? ' selected' : '' %>>HQ</option>
              <% branchCodes.forEach(function (c) { %><option value="<%= c %>"<%= fromNow === c ? ' selected' : '' %>><%= c %><%= c === it.branch_code ? ' (own stock)' : '' %></option><% }) %>
            </select></td>
            <td><input type="date" name="<%= k %>[by]" min="<%= today %>" value="<%= val(it, 'by', it.expected_back || (it.answer ? '' : tomorrow)) %>" aria-label="Arrives by"></td>
            <td><input name="<%= k %>[note]" maxlength="300" class="oo-tnote" value="<%= val(it, 'note', it.answer === 'substitute' ? (it.substitute || '') : (it.reason_for_delay || '')) %>" aria-label="Note to the branch or substitute" autocomplete="off"></td>
            <td class="oo-tnow"><%- include('oos-chip', { it: it, of: of }) %><% if (it.unanswered && it.dueMs !== null) { %><br><small class="<%= it.dueMs < 0 ? 's-off_track' : it.dueMs < 3 * 3600e3 ? 's-watch' : 'muted' %>"><%= of.left(it.dueMs) %></small><% } %></td>
          </tr>
          <% if (bad) { %><tr class="is-error"><td colspan="8"><span class="wk-error"><%= it.item %>: <%= bad %></span></td></tr><% } %>
        <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </section>
  <% }) %>
  <div class="oo-save-bar"><button class="button wide" type="submit">Save all</button></div>
</form>

<section class="oo-card" id="b2b" aria-labelledby="b2b-h">
  <h2 id="b2b-h">Add a B2B item</h2>
  <p class="muted small">Out of stock for a B2B customer. It shows in the B2B part of the table and doesn’t count in any branch’s numbers.</p>
  <form method="post" action="/oos/inbox/b2b" class="oo-form oo-b2b" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="oo-two">
      <label class="oo-label">Item<input name="item" maxlength="120" autocomplete="off" required></label>
      <label class="oo-label">B2B customer<input name="customer" maxlength="80" autocomplete="off" required placeholder="e.g. Klinik Mesra"></label>
    </div>
    <label class="oo-label">Note (optional)<input name="note" maxlength="200" autocomplete="off" placeholder="e.g. needs 20 boxes by Friday"></label>
    <label class="oo-urgent"><input type="checkbox" name="urgent" value="1"> Urgent</label>
    <button class="button secondary" type="submit">Add B2B item</button>
  </form>
</section>
