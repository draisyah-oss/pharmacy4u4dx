<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'academy' }) %>
<%
  const base = '/academy/m/' + encodeURIComponent(mod.code);
  const verified = s.challenges.some(function (c) { return c.verified; });
%>
<main class="page narrow">
  <p><a href="/academy">‹ Academy</a></p>
  <h1><%= mod.title %></h1>
  <p class="muted"><%= mod.track %> · about <%= mod.minutes %> min · <%= xp %> of 80 XP<% if (mod.source) { %> · Source: <%= mod.source %><% } %></p>
  <% if (done) { %><p class="alert alert-good">Module done ✔ (cards, quiz passed and a challenge logged)</p><% } %>

  <section class="wk-card">
    <h2>1. Recap cards <% if (s.cards) { %><span class="s-on_track">✔</span><% } %></h2>
    <p class="muted">Tap a card to see the answer. +<%= XP.cards %> XP.</p>
    <% mod.cards.forEach(function (c) { %>
      <details class="ac-card"><summary><%= c.front %></summary><p><%= c.back %></p></details>
    <% }) %>
    <% if (!s.cards) { %>
      <form method="post" action="<%= base %>/cards">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button wide" type="submit">I have read the cards</button>
      </form>
    <% } %>
  </section>

  <section class="wk-card">
    <h2>2. Quiz <% if (s.quizPassed) { %><span class="s-on_track">✔</span><% } %></h2>
    <p class="muted"><%= mod.questions.length %> questions. Pass at 80% for +<%= XP.quiz %> XP.<% if (s.quizBest) { %> Best so far: <%= s.quizBest.score %> of <%= s.quizBest.total %>.<% } %></p>
    <a class="button<%= s.quizPassed ? ' secondary' : '' %>" href="<%= base %>/quiz"><%= s.quizPassed ? 'Review quiz' : 'Start quiz' %></a>
  </section>

  <section class="wk-card">
    <h2>3. Role-play <% if (s.roleplay) { %><span class="s-on_track">✔</span><% } %></h2>
    <p class="muted"><%= mod.roleplay.customer %> +<%= XP.roleplay %> XP.</p>
    <a class="button<%= s.roleplay ? ' secondary' : '' %>" href="<%= base %>/roleplay"><%= s.roleplay ? 'Practise again' : 'Start role-play' %></a>
  </section>

  <section class="wk-card">
    <h2>4. Counter Challenge <% if (verified) { %><span class="s-on_track">✔</span><% } %></h2>
    <p class="muted">Try it with real customers and log it. Your manager verifies it for +<%= XP.challenge %> XP.<% if (s.challenges.length) { %> Logged: <%= s.challenges.length %>, verified: <%= s.challenges.filter(function (c) { return c.verified; }).length %>.<% } %></p>
    <a class="button<%= s.challenges.length ? ' secondary' : '' %>" href="<%= base %>/challenge">Open challenge</a>
  </section>

  <p class="muted">Learning aid only. When unsure, ask the pharmacist.</p>
</main>
</body>
</html>
