<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'wiki-' + section }) %>
<main class="page wi-page<%= section === 'poster' || section === 'classroom' ? ' wi-wide' : '' %>">
  <p><a href="/wiki">‹ Wiki</a></p>
  <header class="oo-head"><h1><%= S.name %></h1><p class="muted"><%= S.blurb %></p></header>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>
  <div class="wi-actions">
    <% if (section === 'poster' && canSend) { %><a class="button" href="/wiki/poster/new">Send a poster</a><% } %>
    <% if (section !== 'poster' && canEdit) { %><a class="button" href="/wiki/new?section=<%= section %>">Add to <%= S.name %></a><% } %>
    <form class="wi-search" method="get" action="/wiki/s/<%= section %>" role="search">
      <label class="sr-only" for="sq">Search <%= S.name %></label>
      <input id="sq" type="search" name="q" value="<%= q %>" placeholder="Search <%= S.name.toLowerCase() %>">
    </form>
  </div>

  <% if (section === 'poster') { %>
    <section class="oo-card" aria-label="Posters this week">
      <h2>This week</h2>
      <div class="wi-week">
        <% week.forEach(function (w) { if (!w.target && !w.sent) return; %>
          <span class="<%= w.target ? (w.sent >= w.target ? 's-on_track' : 's-off_track') : '' %>"><b><%= w.code %></b> <%= w.sent %><%= w.target ? ' of ' + w.target : '' %> sent · <%= w.approved %> approved</span>
        <% }) %>
      </div>
    </section>
    <% if (queues.mine.length) { %>
      <h2 class="oo-sub">Ours – waiting or to fix</h2>
      <div class="oo-list">
        <% queues.mine.forEach(function (p) { %>
          <a class="oo-item oo-link<%= p.status === 'needs_fix' ? ' is-late' : '' %>" href="/wiki/p/<%= p.id %>">
            <span class="oo-top"><b><%= p.title %></b><span class="oo-chip <%= p.status === 'needs_fix' ? 'oc-warn' : 'oc-info' %>"><%= p.status === 'needs_fix' ? 'FIX NEEDED' : 'WAITING FOR HANIN' %></span></span>
            <% if (p.review_note) { %><span class="oo-note">“<%= p.review_note %>”</span><% } %>
          </a>
        <% }) %>
      </div>
    <% } %>
    <% if (canReview) { %>
      <h2 class="oo-sub" id="review">To approve (<%= queues.pending.length %>)</h2>
      <% if (!queues.pending.length) { %><p class="muted">Nothing waiting.</p><% } %>
      <div class="wi-review">
        <% queues.pending.forEach(function (p) { %>
          <article class="oo-card wi-rev">
            <a href="/wiki/p/<%= p.id %>"><% if (p.kind === 'image') { %><img src="/wiki/f/<%= p.file_id %>" alt="Poster: <%= p.title %>" loading="lazy"><% } else { %><span class="wi-fileicon wi-pdf">PDF</span><% } %></a>
            <div class="wi-rev-text">
              <b><%= p.title %></b>
              <span class="muted small"><%= p.branch_code || 'HQ' %> · <%= p.created_by_name %></span>
              <% if (p.body) { %><p class="small wk-pre"><%= p.body %></p><% } %>
              <form method="post" action="/wiki/p/<%= p.id %>/review" class="wi-rev-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="sr-only" for="note-<%= p.id %>">Note to the branch</label>
                <input id="note-<%= p.id %>" name="note" maxlength="500" placeholder="Note (needed if it needs a fix)">
                <div class="oo-two">
                  <button class="button" name="decision" value="approve" type="submit">Approve</button>
                  <button class="button secondary" name="decision" value="fix" type="submit">Needs a fix</button>
                </div>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
      <h2 class="oo-sub" id="meta">Approved, not yet on Facebook / Instagram (<%= queues.meta.length %>)</h2>
      <% if (!queues.meta.length) { %><p class="muted">All approved posters have been posted.</p><% } %>
      <div class="oo-list">
        <% queues.meta.forEach(function (p) { %>
          <div class="oo-item oo-row wi-meta-row">
            <a href="/wiki/p/<%= p.id %>"><%= p.title %></a><span class="muted small"><%= p.branch_code || '' %></span>
            <a class="link-button" href="/wiki/f/<%= p.file_id %>?download">Download</a>
            <form method="post" action="/wiki/p/<%= p.id %>/meta"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button small-button" type="submit">Posted ✔</button></form>
          </div>
        <% }) %>
      </div>
    <% } %>
    <h2 class="oo-sub">Classroom posters</h2>
  <% } %>

  <% if (!pages.length) { %><p class="muted"><%= q ? 'Nothing matches.' : 'Nothing here yet.' %></p><% } %>
  <div class="<%= section === 'poster' ? 'wi-gallery' : 'wi-list' %>">
    <% pages.forEach(function (p) { %>
      <% if (section === 'poster') { %>
        <a class="wi-tile" href="/wiki/p/<%= p.id %>"><% if (p.kind === 'image') { %><img src="/wiki/f/<%= p.file_id %>" alt="" loading="lazy"><% } else { %><span class="wi-fileicon wi-pdf">PDF</span><% } %>
          <span><b><%= p.title %></b><small class="muted"><%= p.branch_code || '' %><%= p.meta_posted_at ? ' · on Meta' : '' %></small></span></a>
      <% } else { %><%- include('partials/wiki-card', { p: p }) %><% } %>
    <% }) %>
  </div>
</main>
</body>
</html>
