<%- include('partials/head', { bodyClass: 'daily-body' }) %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'daily' }) %>
<%
  const branchQs = (user.role === 'admin' || user.role === 'hq') ? '&branch=' + encodeURIComponent(branch.code) : '';
  const isToday = date === today;
  const editable = !blocked;
  const errorCount = Object.keys(errors).length;
  const money = (n) => 'RM ' + Number(n).toLocaleString('en-MY', { maximumFractionDigits: 0 });
  const num = (n) => Number(n).toLocaleString('en-MY', { maximumFractionDigits: 1 });
  const errorKeys = Object.keys(errors);
  function targetText(f) {
    const h = f.hint;
    if (!h) return '';
    const show = (n) => h.money ? money(n) : num(n);
    if (h.kind === 'track') return 'No target this month';
    if (h.kind === 'ratio') return 'Target ' + Math.round(h.target * 100) + '%';
    if (h.kind === 'pct') return 'Target above ' + Math.round(h.target * 100) + '%';
    if (h.kind === 'perday') return 'Target ' + num(h.target) + ' on storefront days';
    if (h.kind === 'day' && h.target === 0) return 'Weekend target – any today is extra';
    if (h.kind === 'day') return f.type === 'yes_no' ? 'Every day' : 'Target ' + show(h.target);
    return (h.period === 'week' ? 'Week target ' : 'Month target ') + show(h.targetFull);
  }
%>
<div class="daybar">
  <nav class="strip" aria-label="Choose a day">
    <% strip.forEach(function (d) { %>
      <a href="/daily?date=<%= d.date %><%= branchQs %>" class="strip-day<%= d.date === date ? ' is-current' : '' %><%= d.filled ? ' has-data' : '' %>"<%- d.date === date ? ' aria-current="date"' : '' %>>
        <span class="strip-dow"><%= d.date === today ? 'Today' : fmtDate(d.date, { day: undefined, month: undefined }) %></span>
        <span class="strip-num"><%= Number(d.date.slice(8)) %></span>
      </a>
    <% }) %>
  </nav>
  <% if (user.role === 'admin' || user.role === 'hq') { %>
    <form method="get" action="/daily" class="other-date">
      <% if (branchQs) { %><input type="hidden" name="branch" value="<%= branch.code %>"><% } %>
      <label>Another day <input type="date" name="date" value="<%= date %>" max="<%= today %>"></label>
      <button type="submit" class="link-button">Open</button>
    </form>
  <% } %>
</div>

<main class="page daily">
  <%- include('partials/branch-sales', monthSales) %>
  <% if (myCommit) { %>
  <a class="mw-strip" href="/my-week"><span class="mw-label">MY WEEK</span>
    <% if (myCommit.none) { %><span>No commitment yet this week – write it ›</span><% } else { %><span>“<%= myCommit.commitment %>” <%= myCommit.result === 'yes' ? '✔ done' : '– tap when done ›' %></span><% } %></a>
  <% } %>
  <section class="oo-strip" aria-labelledby="oos-strip-h">
    <div class="oo-strip-top">
      <h2 id="oos-strip-h">Out of stock<%= oosItems.length ? ' · ' + oosItems.length + ' open' : '' %></h2>
      <% if (oosCanReport) { %><a class="button small-button" href="<%= oosLink %>">Report out of stock</a> <a class="button small-button secondary" href="/oos/new-items">New item request</a><% } %>
    </div>
    <% oosItems.slice(0, 4).forEach(function (it) { %>
      <a class="oo-mini" href="<%= oosLink %>#oos-<%= it.id %>"><span class="oo-top"><b><%= it.item %></b><%- include('partials/oos-chip', { it: it, of: of }) %></span>
        <span class="oo-line"><%- include('partials/oos-answer-line', { it: it, of: of, at: new Date() }) %></span>
        <% if (it.awaitingBranch) { %><span class="oo-due s-watch">💬 Inventory asked a question – tap to reply</span><% } %></a>
      <% if (oosCanReport && (it.answer === 'hq_deliver' || it.answer === 'transfer') && it.sent_at) { %>
        <form method="post" action="/oos/<%= it.id %>/received" class="oo-done-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/daily"><button class="button oo-good" type="submit">Accept – received <%= it.answer_qty || '' %></button></form>
      <% } %>
    <% }) %>
    <% if (oosItems.length > 4) { %><a href="<%= oosLink %>">All <%= oosItems.length %> items ›</a><% } %>
    <% if (!oosItems.length) { %><p class="muted small">Nothing out of stock. Running low on something? Report it before it hits zero.</p><% } %>
  </section>
  <h1 class="day-title"><%= isToday ? 'Today' : fmtDate(date, { weekday: 'long', day: undefined, month: undefined }) %> <span class="day-date"><%= fmtDate(date, { weekday: isToday ? 'long' : undefined, month: 'long' }) %></span></h1>
  <p class="muted day-meta">
    <% if (lastSaved) { %>Last updated by <%= lastSaved.display_name || 'someone' %> at <%= new Date(lastSaved.updated_at).toLocaleTimeString('en-MY', { timeZone: 'Asia/Kuala_Lumpur', hour: 'numeric', minute: '2-digit' }) %>.<% } else { %>Nothing entered for this day yet.<% } %>
  </p>

  <% if (saved !== null) { %>
    <p class="alert alert-good" role="status"><%= saved === 0 ? 'No changes – everything was already saved.' : 'Saved ' + saved + ' ' + (saved === 1 ? 'number' : 'numbers') + '.' %></p>
  <% } %>
  <% if (errorCount) { %>
    <p class="alert alert-bad" role="alert"><%= errorCount === 1 ? '1 number needs fixing' : errorCount + ' numbers need fixing' %> before it can be saved. Nothing was saved yet. <a href="#f_<%= Object.keys(errors)[0] %>">Show me</a></p>
  <% } %>
  <% if (blocked) { %><p class="alert alert-info"><%= blocked %></p><% } %>
  <% if (synced === 'error') { %><p class="alert alert-bad" role="alert">The sales sheet couldn’t be read<%= sheet && sheet.lastError ? ': ' + sheet.lastError : '' %></p>
  <% } else if (synced !== null && synced !== 'off') { %><p class="alert alert-good" role="status">Sales sheet synced<%= Number(synced) ? ' – ' + synced + ' numbers updated' : ' – no changes' %>.</p><% } %>
  <% if (sheet) { %>
    <form method="post" action="/sales-sheet/sync" class="sheet-note">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="back" value="/daily?date=<%= date %><%= branchQs %>">
      <p>Boxes marked <span class="sheet-tag">Sales sheet</span> fill in from the 2026 Sales Dashboard<% if (sheet.lastSync) { %>, last checked <%= new Date(sheet.lastSync).toLocaleTimeString('en-MY', { timeZone: 'Asia/Kuala_Lumpur', hour: 'numeric', minute: '2-digit' }) %><% } %>. To change one, fix it in the sheet.</p>
      <button type="submit" class="link-button">Check the sheet now</button>
    </form>
  <% } %>

  <nav class="people" aria-label="Jump to a person">
    <% cards.forEach(function (c) { %>
      <a href="#<%= c.id %>" class="people-chip<%= c.isMe ? ' is-me' : '' %>" data-chip="<%= c.id %>"><%= c.name %> <span class="chip-count"><%= c.filled %>/<%= c.fields.length %></span></a>
    <% }) %>
  </nav>

  <form method="post" action="/daily" id="daily-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="date" value="<%= date %>">
    <input type="hidden" name="branch" value="<%= branch.code %>">

    <% cards.forEach(function (c) { %>
      <section class="person" id="<%= c.id %>" data-card="<%= c.id %>">
        <header class="person-head">
          <h2><%= c.name %><% if (c.isMe) { %> <span class="me">you</span><% } %></h2>
          <p class="person-role"><%= c.role %></p>
          <p class="person-count"><span data-count><%= c.filled %></span> of <%= c.fields.length %> filled</p>
        </header>

        <% c.fields.forEach(function (f) {
             const err = errors[f.key];
             const id = 'f_' + f.key; %>
          <div class="field<%= err ? ' has-error' : '' %>" data-field="<%= f.key %>" data-type="<%= f.type %>"
               data-hint="<%= f.hint ? JSON.stringify(f.hint) : '' %>" data-max-of="<%= f.maxOf || '' %>" data-max-of-label="<%= f.maxOfLabel || '' %>"
               data-initial="<%= f.stored === null ? '' : f.stored %>">
            <div class="field-top">
              <label for="<%= id %>"><%= f.label %><% if (f.fromSheet) { %> <span class="sheet-tag">Sales sheet</span><% } %></label>
              <span class="field-target"><%= targetText(f) %></span>
            </div>

            <% if (f.type === 'yes_no') { %>
              <div class="yesno" role="radiogroup" aria-labelledby="<%= id %>-l">
                <span id="<%= id %>-l" class="sr-only"><%= f.label %></span>
                <label class="yn yn-yes"><input type="radio" id="<%= id %>" name="f[<%= f.key %>]" value="1"<%= String(f.value) === '1' ? ' checked' : '' %><%= editable ? '' : ' disabled' %>><span>Yes</span></label>
                <label class="yn yn-no"><input type="radio" name="f[<%= f.key %>]" value="0"<%= String(f.value) === '0' ? ' checked' : '' %><%= editable ? '' : ' disabled' %>><span>No</span></label>
              </div>
            <% } else { %>
              <div class="num-wrap<%= f.type === 'money' ? ' is-money' : '' %><%= f.type === 'percent' ? ' is-pct' : '' %>">
                <% if (f.type === 'money') { %><span class="prefix" aria-hidden="true">RM</span><% } %><% if (f.type === 'percent') { %><span class="suffix" aria-hidden="true">%</span><% } %>
                <input class="num" id="<%= id %>" name="f[<%= f.key %>]" type="text" inputmode="decimal"
                       enterkeyhint="next" autocomplete="off" value="<%= f.value === null ? '' : f.value %>"
                       placeholder="<%= f.fromSheet ? 'Not in the sheet yet' : '–' %>"<%= editable && !f.fromSheet ? '' : ' disabled' %><%= f.fromSheet ? ' data-from-sheet' : '' %><%= err ? ' aria-invalid="true"' : '' %>
                       aria-describedby="<%= id %>-s">
              </div>
            <% } %>

            <% if (f.hint && f.hint.kind !== 'track' && f.type !== 'yes_no') { %><div class="gauge" aria-hidden="true"><span></span></div><% } %>
            <p class="field-status" id="<%= id %>-s" aria-live="polite"><%= err || '' %></p>
          </div>
        <% }) %>
      </section>
    <% }) %>

    <% if (editable) { %>
      <div class="savebar">
        <p class="savebar-note" data-dirty-note>All saved</p>
        <button type="submit" class="button save">Save <%= isToday ? 'today' : fmtDate(date) %></button>
      </div>
    <% } %>
  </form>
</main>
<script src="/js/daily.js?v=6" defer></script>
</body>
</html>
