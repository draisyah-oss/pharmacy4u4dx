<%- include('../partials/head', { bodyClass: 'admin-body' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/admin-nav', { active: '/admin/audit' }) %>
<%
  const qs = (p) => '/admin/audit?page=' + p + (q ? '&q=' + encodeURIComponent(q) : '') + (who ? '&who=' + encodeURIComponent(who) : '');
  const v = (s) => s === null || s === undefined ? '' : String(s).replace(/^"|"$/g, '');
%>
<main class="page admin">
  <h1>Audit log</h1>
  <form method="get" action="/admin/audit" class="audit-filter">
    <label>Search <input name="q" value="<%= q %>" placeholder="e.g. WM T1, set_pin, 2026-10-14"></label>
    <label>Who <select name="who"><option value="">Anyone</option><% users.forEach(function (u) { %><option value="<%= u.username %>"<%= who === u.username ? ' selected' : '' %>><%= u.display_name %></option><% }) %></select></label>
    <button class="button small-button" type="submit">Filter</button>
  </form>
  <div class="table-wrap">
    <table class="admin-table audit">
      <thead><tr><th>When</th><th>Who</th><th>What</th><th>Change</th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="nowrap"><%= new Date(r.at).toLocaleString('en-MY', { timeZone: 'Asia/Kuala_Lumpur', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) %></td>
            <td><%= r.who %></td>
            <td><span class="audit-action"><%= r.action.replace(/_/g, ' ') %></span> <%= r.record_key || '' %></td>
            <td class="nowrap"><% if (r.old_value !== null || r.new_value !== null) { %><%= v(r.old_value) || '–' %> → <b><%= v(r.new_value) || '–' %></b><% } %></td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %><tr><td colspan="4" class="muted">Nothing found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <p class="pager"><% if (page > 1) { %><a href="<%= qs(page - 1) %>">Newer</a><% } %> <% if (more) { %><a href="<%= qs(page + 1) %>">Older</a><% } %></p>
</main>
</body>
</html>
