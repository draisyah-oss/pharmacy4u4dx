<%- include('../partials/head', { bodyClass: 'admin-body' }) %>
<%- include('../partials/topbar') %>
<%- include('../partials/admin-nav', { active: '/admin/people' }) %>
<%
  const code = hq ? 'HQ' : branch.code;
  const loginText = (p) => {
    if (!p.user_id) return 'No login';
    if (!p.login_active) return 'Login off';
    if (p.locked) return 'Locked – too many wrong tries';
    if (p.login_role === 'branch_staff' || p.login_role === 'hq_staff') return p.has_pin ? 'PIN set' : 'No PIN yet';
    return p.has_password ? 'Password set' : 'No password yet';
  };
  const roleText = { branch_staff: 'Staff (PIN)', branch_manager: 'Manager (password)', hq: 'HQ – full access (password)', hq_staff: 'HQ staff – own KPIs (PIN)' };
  const hqOptions = (sel) => '<option value="hq_staff"' + (sel === 'hq_staff' ? ' selected' : '') + '>HQ staff – PIN: group + HQ scoreboard, own KPIs</option>'
    + '<option value="hq"' + (sel === 'hq' ? ' selected' : '') + '>HQ full access – password: all branches, HQ input</option>';
%>
<main class="page admin">
  <%- include('../partials/branch-pick', { list, branch, hq, base: '/admin/people', withHq: true }) %>
  <h1>People & logins <span class="muted"><%= hq ? 'HQ' : branch.name %></span></h1>
  <p class="muted">Staff log in with a 4-digit PIN, managers and HQ with a password. PINs and passwords are never shown or logged – only that they were changed.</p>

  <% people.forEach(function (p) { %>
    <section class="admin-person<%= p.active ? '' : ' is-off' %>" id="person-<%= p.id %>">
      <header>
        <h2><%= p.name %> <span class="muted"><%= p.job %></span></h2>
        <p class="login-state <%= p.locked || (!p.has_pin && !p.has_password) ? 's-off_track' : 's-on_track' %>"><%= p.username ? p.username + ' · ' : '' %><%= roleText[p.login_role] || '' %> · <%= loginText(p) %></p>
      </header>

      <% if (p.active) { %>
        <div class="admin-actions">
          <% if (p.user_id) { %>
            <form method="post" action="/admin/users/<%= p.user_id %>/secret" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>">
              <% if (p.login_role === 'branch_staff' || p.login_role === 'hq_staff') { %>
                <label>New PIN <input name="secret" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="off" required></label>
                <button class="button small-button" type="submit"><%= p.has_pin ? 'Change PIN' : 'Set PIN' %></button>
              <% } else { %>
                <label>New password <input name="secret" type="text" minlength="8" autocomplete="off" required></label>
                <button class="button small-button" type="submit"><%= p.has_password ? 'Change password' : 'Set password' %></button>
              <% } %>
            </form>
            <% if (p.locked) { %>
              <form method="post" action="/admin/users/<%= p.user_id %>/unlock" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>">
                <button class="button secondary small-button" type="submit">Unlock</button>
              </form>
            <% } %>
          <% } %>
        </div>

        <details class="admin-details">
          <summary>Edit <%= p.name %></summary>
          <form method="post" action="/admin/people/<%= p.id %>" class="admin-fields">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>">
            <label>Name <input name="name" value="<%= p.name %>" required></label>
            <label>Job <input name="job" value="<%= p.job %>" required></label>
            <label>Username <input name="username" value="<%= p.username || '' %>" autocapitalize="none"></label>
            <% if (!hq) { %>
              <label>Logs in as
                <select name="login_role">
                  <option value="branch_staff"<%= p.login_role === 'branch_staff' ? ' selected' : '' %>>Staff – PIN, daily entry only</option>
                  <option value="branch_manager"<%= p.login_role === 'branch_manager' ? ' selected' : '' %>>Manager – password, scoreboard too</option>
                </select>
              </label>
            <% } else if (p.user_id) { %>
              <label>Logs in as <select name="login_role"><%- hqOptions(p.login_role) %></select></label>
            <% } %>
            <p class="small muted">A new name carries over to the measures and daily fields they own.</p>
            <button class="button small-button" type="submit">Save changes</button>
          </form>
          <form method="post" action="/admin/people/<%= p.id %>/active" class="admin-danger">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>"><input type="hidden" name="active" value="false">
            <button class="link-button" type="submit">Remove <%= p.name %> (they can no longer log in; history is kept)</button>
          </form>
        </details>
      <% } else { %>
        <form method="post" action="/admin/people/<%= p.id %>/active" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>"><input type="hidden" name="active" value="true">
          <span class="muted">Removed – can’t log in.</span> <button class="link-button" type="submit">Bring back</button>
        </form>
      <% } %>
    </section>
  <% }) %>

  <section class="admin-person admin-add">
    <h2>Add someone to <%= hq ? 'HQ' : branch.name %></h2>
    <form method="post" action="/admin/people" class="admin-fields">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="<%= code %>">
      <label>Name <input name="name" required></label>
      <label>Job <input name="job" placeholder="e.g. Sales Assistant" required></label>
      <label>Username <input name="username" placeholder="their first name, if left empty" autocapitalize="none"></label>
      <% if (!hq) { %>
        <label>Logs in as
          <select name="login_role"><option value="branch_staff">Staff – PIN, daily entry only</option><option value="branch_manager">Manager – password, scoreboard too</option></select>
        </label>
      <% } else { %>
        <label>Logs in as <select name="login_role"><%- hqOptions('hq_staff') %></select></label>
      <% } %>
      <button class="button small-button" type="submit">Add</button>
    </form>
  </section>

  <% if (hq && admin) { %>
    <section class="admin-person">
      <h2>Admin login <span class="muted">username <%= admin.username %></span></h2>
      <form method="post" action="/admin/users/<%= admin.id %>/secret" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="branch" value="HQ">
        <label>New password <input name="secret" type="text" minlength="8" autocomplete="off" required></label>
        <button class="button small-button" type="submit">Change admin password</button>
      </form>
    </section>
  <% } %>
</main>
</body>
</html>
