<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'academy' }) %>
<main class="page narrow">
  <p><a href="/academy/m/<%= encodeURIComponent(mod.code) %>">‹ <%= mod.title %></a></p>
  <h1>Quiz: <%= mod.title %></h1>
  <% if (result) { %>
    <p class="alert <%= result.passed ? 'alert-good' : 'alert-bad' %>">
      <%= result.passed ? 'Syabas! You passed' : 'Not quite. You did not reach 80%' %>: <%= result.score %> of <%= result.total %>.
      <%= result.passed ? '+15 XP.' : 'You can try again the next working day.' %>
    </p>
    <% result.results.forEach(function (x, i) { %>
      <section class="wk-card">
        <h2><%= i + 1 %>. <%= x.right ? 'Syabas! ✔' : 'Not quite.' %><% if (x.right) { %> <span class="ac-xp-pop">+3 XP</span><% } %></h2>
        <p><%= x.q.q %></p>
        <p><strong>Correct:</strong> <%= x.q.correct.map(function (n) { return x.q.options[n]; }).join('; ') %></p>
        <% if (!x.right) { %><p class="muted">You chose: <%= x.picked.length ? x.picked.map(function (n) { return x.q.options[n]; }).join('; ') : 'nothing' %></p><% } %>
        <p><strong>Why:</strong> <%= x.q.why %></p>
      </section>
    <% }) %>
    <p><a class="button" href="/academy/m/<%= encodeURIComponent(mod.code) %>">Back to the module</a></p>
  <% } else if (blocked) { %>
    <p class="alert alert-info"><%= blocked %></p>
    <p><a class="button" href="/academy/m/<%= encodeURIComponent(mod.code) %>">Back to the module</a></p>
  <% } else { %>
    <form method="post" action="/academy/m/<%= encodeURIComponent(mod.code) %>/quiz">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% mod.questions.forEach(function (q, i) { %>
        <fieldset class="wk-card ac-q">
          <legend><%= i + 1 %>. <%= q.q %><% if (q.multi) { %> <span class="muted">(select all that apply)</span><% } %></legend>
          <% q.options.forEach(function (o, n) { %>
            <label class="ac-opt"><input type="<%= q.multi ? 'checkbox' : 'radio' %>" name="q<%= i %>" value="<%= n %>"> <span><%= o %></span></label>
          <% }) %>
        </fieldset>
      <% }) %>
      <button class="button wide" type="submit">Check my answers</button>
    </form>
  <% } %>
  <p class="muted">Learning aid only. When unsure, ask the pharmacist.</p>
</main>
<script src="/js/academy.js"></script>
</body>
</html>
