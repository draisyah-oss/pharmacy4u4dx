<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'oosproducts' }) %>
<main class="page oo-page">
  <h1>Product list (Dynamod)</h1>
  <p class="muted">Branches pick out-of-stock items from this list, so every report has the Dynamod description, stock ID and UOM – the same as you order. <%= stats.active %> products<%= last ? ' · from ' + last.source + (last.by ? ' (' + last.by + ')' : '') + ', ' + new Date(last.at).toLocaleDateString('en-GB', { timeZone: 'Asia/Kuala_Lumpur', day: 'numeric', month: 'short' }) : '' %>.</p>
  <% if (ok) { %><p class="alert alert-good"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad"><%= err %></p><% } %>
  <section class="oo-card">
    <h2>Find a product</h2>
    <p class="muted small">Cost and prices are for the inventory team and admin only – branches never see them. Margin = (Price 1 − cost) ÷ Price 1.
      <% if (!priced) { %><b>No prices yet – upload the latest Dynamod masterlist below once to add cost, Price 1 and Price 2.</b><% } %></p>
    <form method="get" class="pp-find"><input type="search" name="q" value="<%= q %>" placeholder="name, generic, stock ID or barcode" aria-label="Search"><button class="button secondary">Search</button></form>
    <% if (q) { %>
      <% if (!found.length) { %><p class="muted">Nothing found.</p><% } else { %>
      <div class="mo-scroll"><table class="mo-t"><thead><tr><th>Description</th><th>Stock ID</th><th>UOM</th><th class="num">Cost (RM)</th><th class="num">Selling – Price 1 (RM)</th><th class="num">Price 2 (RM)</th><th class="num">Margin</th><th>Barcode</th><th>Generic</th></tr></thead>
        <tbody><% const rm = function (v, d) { return v === null || v === undefined ? '–' : Number(v).toFixed(d); };
          found.forEach(function (p) { const c = p.cost === null ? null : Number(p.cost); const s1 = p.price1 === null ? null : Number(p.price1);
            const m = c !== null && s1 ? Math.round((s1 - c) / s1 * 100) : null; %><tr><th><%= p.description %></th><td><%= p.stock_id %></td><td><%= p.uom %></td>
          <td class="num"><%= rm(p.cost, 2) %></td><td class="num"><b><%= rm(p.price1, 2) %></b></td><td class="num"><%= rm(p.price2, 2) %></td>
          <td class="num<%= m !== null && m < 10 ? ' pp-low' : '' %>"><%= m === null ? '–' : m + '%' %></td><td><%= p.barcode %></td><td><%= p.generic %></td></tr><% }) %></tbody></table></div>
      <% } %>
    <% } %>
  </section>
  <section class="oo-card">
    <h2>Update from a new Dynamod export</h2>
    <p class="muted small">Export the stock masterlist from Dynamod as Excel (.xlsx) or .csv (same columns: Active, Stock ID, Barcode, Description 1, UOM ID, Balance Quantity (UOM), Cost, Price 1, Price 2 …) and upload it. The stock balance is used for zakat quotations (Readystock / Pre-order); for the weekly stock export, tick “no longer listed” so the list matches the file. Products are matched by barcode; new ones are added, changed names updated.</p>
    <form method="post" action="/oos/products" class="oo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="file"><input type="hidden" name="name">
      <label class="oo-label">Masterlist file<input type="file" accept=".xlsx,.csv" data-xlsx-upload required></label>
      <label><input type="checkbox" name="replace" value="1"> Products not in this file are no longer listed (full export)</label>
      <button class="button" type="submit">Upload</button>
    </form>
  </section>
</main>
<script src="/js/product-pick.js?v=1" defer></script>
</body>
</html>
