<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'status' }) %>
  <main class="page">
    <h1>Setup check</h1>
    <p class="muted"><%= settings.period %>. <%= settings.company_wig %>.</p>
    <section class="notice">
      The database is ready and seed.json is loaded. Scoreboards come next.
      <span class="muted">Database: <%= dbKind === 'postgres' ? 'PostgreSQL' : 'local (PGlite)' %> ·
      tracker started <%= settings.tracker_start_date %></span>
    </section>

    <h2>Branches</h2>
    <div class="cards">
      <% branches.forEach(function (b) { %>
        <article class="card">
          <h3><%= b.name %> <span class="tag"><%= b.code %></span></h3>
          <p class="wig"><%= b.wig %></p>
          <dl>
            <div><dt>People</dt><dd><%= b.people %></dd></div>
            <div><dt>Daily fields</dt><dd><%= b.fields %></dd></div>
            <div><dt>Measures</dt><dd><%= b.measures %></dd></div>
            <div><dt>Entries</dt><dd><%= b.entries %></dd></div>
          </dl>
          <p class="muted small"><%= b.names %><%= b.has_zakat ? '' : ' · no zakat' %></p>
        </article>
      <% }) %>
    </div>

    <h2>Sales sheet</h2>
    <% if (!sheet || !sheet.enabled) { %>
      <p>Not linked yet<%= sheet && sheet.configError ? ' – ' + sheet.configError : '' %>. Walk-in, transactions and the other sheet columns are typed in the app until it is. README → “Sales sheet” has the steps.</p>
    <% } else { %>
      <p>Linked as <b><%= sheet.serviceAccountEmail %></b>.
        <%= sheet.lastSync ? 'Last checked ' + new Date(sheet.lastSync).toLocaleString('en-MY', { timeZone: 'Asia/Kuala_Lumpur' }) + '.' : 'Not checked yet.' %>
        <% if (sheet.lastError) { %><span class="s-off_track">Last problem: <%= sheet.lastError %></span><% } %></p>
      <% if (sheet.missing && sheet.missing.length) { %>
        <div class="alert alert-bad"><p>These columns weren’t found in the sheet’s newest month, so those numbers stay empty – check the header names:</p>
          <ul><% sheet.missing.forEach(function (m) { %><li><%= m %></li><% }) %></ul></div>
      <% } %>
      <% if (sheet.summaryError) { %><p class="s-off_track">Summary tabs: <%= sheet.summaryError %></p><% } %>
      <form method="post" action="/sales-sheet/sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/status"><button class="button small-button" type="submit">Check the sheet now</button></form>
    <% } %>

    <h2>HQ and logins</h2>
    <p><%= totals.hq_measures %> HQ measures (Alia, Hanin) · <%= totals.users %> logins created,
      <%= totals.users_ready %> with a password or PIN set.</p>
  </main>
</body>
</html>
