<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'wiki' }) %>
<main class="page wi-page">
  <header class="oo-head"><h1>Wiki &amp; Classroom</h1><p class="muted">Everything about how Pharmacy4U works, and the Pharmacy4U Classroom.</p></header>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <form class="wi-search" method="get" action="/wiki" role="search">
    <label class="sr-only" for="wq">Search the wiki</label>
    <input id="wq" type="search" name="q" value="<%= q %>" placeholder="Search… e.g. gout, receiving SOP, cashier">
    <button class="button small-button" type="submit">Search</button>
  </form>
  <% if (results) { %>
    <h2 class="oo-sub"><%= results.length %> found for “<%= q %>”</h2>
    <div class="wi-list"><% results.forEach(function (p) { %><%- include('partials/wiki-card', { p: p }) %><% }) %></div>
    <% if (!results.length) { %><p class="muted">Nothing matches. Try another word.</p><% } %>
  <% } else { %>
    <div class="wi-sections">
      <a class="wi-sec" href="/wiki/org"><b>Org chart</b><span>Who does what, HQ and every branch</span></a>
      <% Object.keys(SECTIONS).forEach(function (k) { %>
        <a class="wi-sec" href="/wiki/s/<%= k %>"><b><%= SECTIONS[k].name %></b><span><%= SECTIONS[k].blurb %></span><small><%= stats.counts[k] || 0 %> <%= (stats.counts[k] || 0) === 1 ? 'item' : 'items' %><%= k === 'poster' && canReview && stats.pending ? ' · ' + stats.pending + ' waiting for approval' : '' %></small></a>
      <% }) %>
    </div>
    <div class="wi-actions">
      <% if (canEdit) { %><a class="button" href="/wiki/new">Add a page or file</a><% } %>
      <% if (canSend) { %><a class="button secondary" href="/wiki/poster/new">Send a poster</a><% } %>
    </div>
    <% if (canEdit) { %>
      <section class="oo-card wi-stats" aria-label="Wiki progress">
        <div><span class="muted small">Staff who have opened the wiki</span><b><%= stats.staff.opened %> of <%= stats.staff.total %></b></div>
        <div><span class="muted small">Job descriptions</span><b><%= stats.counts.jd || 0 %></b></div>
        <div><span class="muted small">SOPs</span><b><%= stats.counts.sop || 0 %></b></div>
        <div><span class="muted small">Posters this week</span><b><%= stats.posters.filter(function (p) { return p.target; }).map(function (p) { return p.code + ' ' + p.sent + ' of ' + p.target; }).join(' · ') || stats.posters.reduce(function (a, p) { return a + p.sent; }, 0) %></b></div>
      </section>
    <% } %>
    <% if (stats.latest.length) { %>
      <h2 class="oo-sub">New and updated</h2>
      <div class="wi-list"><% stats.latest.forEach(function (p) { %><%- include('partials/wiki-card', { p: p }) %><% }) %></div>
    <% } else { %><p class="muted">Nothing here yet<%= canEdit ? ' – start with “Add a page or file”.' : '.' %></p><% } %>
  <% } %>
</main>
</body>
</html>
