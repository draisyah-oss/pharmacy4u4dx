<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'wiki' }) %>
<main class="page wi-page">
  <p><a href="<%= page ? '/wiki/p/' + page.id : '/wiki' %>">‹ Back</a></p>
  <form method="post" action="<%= page ? '/wiki/p/' + page.id + '/edit' : '/wiki/new' %>" enctype="multipart/form-data" class="oo-card oo-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h1><%= title %></h1>
    <label class="oo-label">Section
      <select name="section" class="wi-select">
        <% Object.keys(SECTIONS).filter(function (k) { return k !== 'poster'; }).forEach(function (k) { %><option value="<%= k %>"<%= (typed.section || section) === k ? ' selected' : '' %>><%= SECTIONS[k].name %></option><% }) %>
      </select>
    </label>
    <label class="oo-label">Title<input name="title" maxlength="160" value="<%= typed.title || '' %>" required placeholder="e.g. Receiving stock from a supplier"<%= errors.title ? ' aria-invalid="true"' : '' %>>
      <% if (errors.title) { %><span class="wk-error"><%= errors.title %></span><% } %></label>
    <label class="oo-label">Text <small class="muted">– blank line = new paragraph · start lines with “- ” for a list · “# ” for a heading</small>
      <textarea name="body" rows="12" maxlength="20000"><%= typed.body || '' %></textarea>
      <% if (errors.body) { %><span class="wk-error"><%= errors.body %></span><% } %></label>
    <label class="oo-label">File <small class="muted">– slides, PDF, Word, Excel, picture or short video, up to 15 MB<%= page && page.filename ? ' · now: ' + page.filename : '' %></small>
      <input type="file" name="file" accept="image/*,application/pdf,.ppt,.pptx,.doc,.docx,.xls,.xlsx,video/mp4">
      <% if (errors.file) { %><span class="wk-error"><%= errors.file %></span><% } %></label>
    <% if (page && page.file_id) { %><label class="oo-inline"><input type="checkbox" name="remove_file" value="1"> Remove the current file</label><% } %>
    <label class="oo-label">Tags <small class="muted">(optional, helps search)</small><input name="tags" maxlength="200" value="<%= typed.tags || '' %>" placeholder="e.g. receiving, inventory, branch"></label>
    <button class="button wide" type="submit"><%= page ? 'Save' : 'Add to the wiki' %></button>
  </form>
</main>
</body>
</html>
