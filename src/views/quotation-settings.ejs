<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'quotations' }) %>
<main class="page qt-page">
  <p class="small"><a href="/quotations">← Zakat quotations</a></p>
  <h1>Quotation settings</h1>
  <p class="muted">For admin and Alia. Changes apply to drafts and new quotations; issued PDFs never change. Signatures are kept in the app’s database only (never in the code on GitHub).</p>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>

  <section class="oo-card qt-card">
    <h2>Prices and recipient</h2>
    <form method="post" action="/quotations/settings" class="qt-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="qt-grid2">
        <label class="oo-label">Markup (%) <span class="muted small">price = cost × (1 + markup), rounded up to the next 10 sen</span>
          <input type="text" name="markup_default" value="<%= Math.round(settings.markup_default * 10000) / 100 %>" inputmode="decimal" required></label>
        <label class="oo-label">Floor (%) <span class="muted small">a price under cost + this shows amber</span>
          <input type="text" name="markup_floor" value="<%= Math.round(settings.markup_floor * 10000) / 100 %>" inputmode="decimal" required></label>
      </div>
      <label class="oo-label">Default recipient <span class="muted small">(“To:” – one line each)</span><textarea name="recipient" rows="5" maxlength="600" required><%= settings.recipient %></textarea></label>
      <div class="qt-grid2">
        <label class="oo-label">TEL <input type="text" name="tel" value="<%= settings.tel %>" maxlength="80"></label>
        <label class="oo-label">C. C. <input type="text" name="cc" value="<%= settings.cc %>" maxlength="120"></label>
      </div>
      <button class="button" type="submit">Save</button>
    </form>
  </section>

  <section class="oo-card qt-card">
    <h2>Ref numbers</h2>
    <p class="muted small">Each number is taken when a quotation PDF is generated and never reused. For a new year, set its first number here (Dr Aisyah decides it) – until then the app won’t make quotations that year.</p>
    <div class="table-wrap"><table class="admin-table">
      <thead><tr><th>Series</th><th>Year</th><th>Last used</th><th>Next</th></tr></thead>
      <tbody><% series.forEach(function (r) { %><tr><td><%= r.series %></td><td><%= r.year %></td><td><%= r.last_no ? formatRef(r.series, r.year, r.last_no) : '–' %></td><td><b><%= formatRef(r.series, r.year, r.next_no) %></b></td></tr><% }) %></tbody>
    </table></div>
    <form method="post" action="/quotations/settings/series" class="qt-form qt-grid4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="oo-label">Series <select name="series"><% seriesList.forEach(function (x) { %><option><%= x %></option><% }) %></select></label>
      <label class="oo-label">Year <input type="number" name="year" value="<%= thisYear %>" min="2026" max="2100" required></label>
      <label class="oo-label">Next number <input type="number" name="next_no" min="1" max="9999" required></label>
      <button class="button secondary" type="submit">Set the next number</button>
    </form>
  </section>

  <% Object.keys(configs).forEach(function (code) { const b = configs[code]; const pics = [['signature', 'Signature'], ['footer', 'Footer picture (optional – a full replacement for the address band)']]; %>
  <section class="oo-card qt-card" id="b-<%= code %>">
    <h2><%= code %> – <%= b.name %> <span class="muted small"><%= b.series %></span></h2>
    <form method="post" action="/quotations/settings/branch/<%= code %>" class="qt-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="qt-grid2">
        <label class="oo-label">Name under the signature <input type="text" name="signer" value="<%= b.signer %>" maxlength="80" placeholder="FULL NAME AS ON THE QUOTATION"></label>
        <label class="oo-label">Title under the name <input type="text" name="title" value="<%= b.title %>" maxlength="60" placeholder="(Pharmacist)"></label>
      </div>
      <% if (code !== 'WM') { %><label class="oo-label">Address in the footer <span class="muted small">(under “Pharmacy4u <%= b.name %>” in WM’s footer band – up to 3 lines, e.g. street, town, Tel)</span><textarea name="footer_lines" rows="3" maxlength="400"><%= b.footer_lines %></textarea></label><% } %>
      <button class="button secondary" type="submit">Save <%= code %></button>
    </form>
    <div class="qt-pics">
    <% pics.forEach(function (p) { const has = b.images[p[0]] || (code === 'WM' && p[0] === 'footer'); %>
      <form method="post" action="/quotations/settings/image/<%= code %>/<%= p[0] %>" class="qt-form qt-pic">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="file">
        <p class="small"><b><%= p[1] %></b><br>
          <% if (b.images[p[0]]) { %><img src="/quotations/settings/image/<%= code %>/<%= p[0] %>" alt="<%= p[1] %>" class="qt-sig"><% } else if (has) { %><span class="muted">Built-in WM footer</span><% } else { %><span class="muted">None yet<%= p[0] === 'signature' ? ' – PDFs are made without a signature' : code === 'WM' ? '' : ' – WM’s footer with the address above is used' %></span><% } %></p>
        <label class="oo-label small">.jpg or .png <input type="file" accept="image/jpeg,image/png" data-dataurl-upload required></label>
        <button class="button secondary small-button" type="submit">Upload</button>
      </form>
    <% }) %>
    </div>
  </section>
  <% }) %>
</main>
<script src="/js/quotation.js?v=2" defer></script>
</body>
</html>
