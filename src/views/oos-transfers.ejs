<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'oostransfers' }) %>
<% const done = function (it, label) { %>
  <form method="post" action="/oos/<%= it.id %>/done"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/oos/transfers"><button class="button oo-good wide" type="submit"><%= label %></button></form>
<% }; const from = function (it) { return it.answer !== 'transfer' ? 'HQ' : it.from_branch_id === it.branch_id ? it.from_code + ' own stock' : it.from_code; }; %>
<main class="page oo-page">
  <header class="oo-head"><h1>Deliveries to send</h1><p class="muted">HQ deliveries and branch transfers from Inventory’s answers. Pick, then send within <%= hours %> hours – the branch sees each step and taps Accept when it arrives.</p></header>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>
  <% if (!toSend.length) { %><p class="muted">Nothing to send right now.</p><% } %>
  <div class="oo-list">
  <% toSend.forEach(function (it) { %>
    <article class="oo-item<%= it.urgent ? ' is-urgent' : '' %>">
      <header class="oo-top"><b><%= it.item %> × <%= it.answer_qty %></b><% if (it.urgent) { %><span class="oo-chip oc-bad">URGENT</span><% } else { %><%- include('partials/oos-chip', { it: it, of: of }) %><% } %></header>
      <p class="oo-route"><b><%= from(it) %></b> → <b><%= it.branch_code %></b> · send by <%= of.when(it.sendBy, at) %></p>
      <p class="oo-due<%= it.sendMs < 0 ? ' s-off_track' : it.sendMs < 4 * 3600e3 ? ' s-watch' : ' s-on_track' %>"><%= of.left(it.sendMs) %><%= it.picked_at ? ' · picked ' + of.when(it.picked_at, at) : '' %></p>
      <div class="oo-two">
        <form method="post" action="/oos/<%= it.id %>/picked"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary wide" type="submit"<%= it.picked_at ? ' disabled' : '' %>><%= it.picked_at ? 'Picked ✔' : '1 · Picked' %></button></form>
        <form method="post" action="/oos/<%= it.id %>/sent"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button wide" type="submit">2 · Sent – on the way</button></form>
      </div>
      <% done(it, 'Already delivered – done'); %>
    </article>
  <% }) %>
  </div>
  <% if (sent.length) { %>
    <h2 class="oo-sub">On the way – waiting for the branch to accept</h2>
    <p class="muted small">If it has arrived and the branch hasn’t tapped Accept, close it here.</p>
    <div class="oo-list">
    <% sent.forEach(function (it) { %>
      <article class="oo-item">
        <div class="oo-row"><span><b><%= it.item %> × <%= it.answer_qty %></b> · <%= from(it) %> → <%= it.branch_code %></span><span class="muted small">sent <%= of.when(it.sent_at, at) %></span></div>
        <% done(it, 'Delivered – done'); %>
      </article>
    <% }) %>
    </div>
  <% } %>
</main>
</body>
</html>
