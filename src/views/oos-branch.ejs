<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'oos' }) %>
<% if (branches.length) { %>
<div class="daybar"><nav class="strip" aria-label="Choose a branch">
  <% branches.forEach(function (b) { %><a href="/oos?branch=<%= encodeURIComponent(b.code) %>" class="strip-pill<%= b.code === branch.code ? ' is-current' : '' %>"><%= b.code %></a><% }) %>
</nav></div>
<% } %>
<main class="page oo-page">
  <nav class="strip oo-tabs" aria-label="Out of stock or new item">
    <a href="/oos<%= bq %>" class="strip-pill is-current" aria-current="page">Out of stock</a>
    <a href="/oos/new-items<%= bq %>" class="strip-pill">New item request<%= newCount ? ' (' + newCount + ')' : '' %></a>
  </nav>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>

  <% if (canReport) { const t = typed; %>
  <section class="oo-card" aria-labelledby="rep-h">
    <h1 id="rep-h">Report out of stock</h1>
    <p class="muted">Report it when it hits the minimum on the shelf – don’t wait for zero, and don’t wait for Monday.</p>
    <form method="post" action="/oos<%= bq %>" class="oo-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="oo-label pp-wrap">Item <% if (productList) { %><small class="muted">– type a few letters and pick it from the Dynamod list</small><% } %>
        <input name="item" maxlength="120" autocomplete="off" required value="<%= t.item || '' %>" placeholder="<%= productList ? 'e.g. loyuric 100' : 'e.g. Loyuric 100mg (30s)' %>"<%= productList ? ' data-product-search data-required=1' : '' %><%= errors.item ? ' aria-invalid="true"' : '' %>>
        <input type="hidden" name="product_id" value="<%= t.product_id || '' %>">
        <small class="pp-info" data-product-info></small>
        <% if (errors.item) { %><span class="wk-error"><%= errors.item %></span><% } %>
      </label>
      <fieldset class="oo-set">
        <legend>How many left?</legend>
        <div class="yesno">
          <label class="yn yn-no"><input type="radio" name="left" value="none"<%= t.left === 'none' ? ' checked' : '' %>><span>None (0)</span></label>
          <label class="yn yn-yes"><input type="radio" name="left" value="low"<%= t.left === 'low' ? ' checked' : '' %>><span>Low</span></label>
        </div>
        <label class="oo-inline">If low, how many? <input name="left_qty" inputmode="numeric" class="num oo-qty" value="<%= t.left_qty || '' %>" autocomplete="off"></label>
        <% if (errors.left) { %><span class="wk-error"><%= errors.left %></span><% } %>
      </fieldset>
      <fieldset class="oo-set">
        <legend>Customers asking for it today?</legend>
        <div class="yesno yesno-3">
          <% [['0', 'None'], ['1-2', '1–2'], ['3+', '3 or more']].forEach(function (o) { %>
            <label class="yn yn-yes"><input type="radio" name="asking" value="<%= o[0] %>"<%= t.asking === o[0] ? ' checked' : '' %>><span><%= o[1] %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <%- include('partials/photo-input', { id: 'ph-report', label: 'Add a photo (optional)' }) %>
      <% if (errors.photo) { %><span class="wk-error"><%= errors.photo %></span><% } %>
      <label class="oo-urgent"><input type="checkbox" name="urgent" value="1"<%= t.urgent ? ' checked' : '' %>> Urgent – chronic patient waiting</label>
      <label class="oo-label">Note (optional)
        <input name="note" maxlength="200" autocomplete="off" value="<%= t.note || '' %>" placeholder="e.g. patient collects every 2 weeks">
        <% if (errors.note) { %><span class="wk-error"><%= errors.note %></span><% } %>
      </label>
      <button class="button wide" type="submit">Send to Inventory</button>
      <p class="muted small oo-center">Inventory answers by <%= targets.answer_by_hour %> am the next working day. The answer shows here and on Daily entry.</p>
    </form>
  </section>
  <% } %>

  <section aria-labelledby="ours-h">
    <h2 id="ours-h"><%= canReport ? 'Our out-of-stock items' : branch.name + ' – out of stock' %></h2>
    <% const openLoss = items.filter(function (it) { return it.isOpen; }).reduce(function (a, it) { return a + (it.estLoss || 0); }, 0);
       if (openLoss) { %><p class="oo-loss-line">💸 Still out of stock: <b>≈ RM <%= Math.round(openLoss).toLocaleString('en-MY') %></b> in sales lost so far (selling price × customers asking). Push to get them back.</p><% } %>
    <% if (!items.length) { %><p class="muted">Nothing out of stock right now.</p><% } %>
    <% const vq = function (v) { return '/oos' + (bq ? bq + '&' : '?') + 'view=' + v; }; %>
    <% if (items.length) { %><nav class="strip oo-view" aria-label="Show as"><a href="<%= vq('table') %>" class="strip-pill<%= view === 'table' ? ' is-current' : '' %>">Table – tick &amp; adjust</a><a href="<%= vq('cards') %>" class="strip-pill<%= view === 'cards' ? ' is-current' : '' %>">Cards</a></nav><% } %>
    <% if (view === 'table' && items.length) { %>
    <%# 5 Nov (CEO): like Excel – tick received / cancel, adjust left, customers, urgent, note; one Save. ▾ filters per column. %>
    <form method="post" action="/oos/table<%= bq %>" class="oo-btable-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="table-wrap"><table class="oo-table oo-btable" data-xfilter aria-label="Our out-of-stock items">
        <thead><tr><% if (canClose) { %><th data-xfilter-off title="Received – back in stock / accept the delivery">✔ Got it</th><th data-xfilter-off title="Cancel – not needed any more">✕ Cancel</th><% } %>
          <th>Item</th><th>Status</th><th>Inventory’s answer</th><th>Reported</th><th>Left</th><th>Customers asking</th><th>Urgent</th><th>Note</th><th class="n">Sales lost (RM)</th></tr></thead>
        <tbody>
        <% items.forEach(function (it) { const k = 'r[i' + it.id + ']'; const ed = canClose && it.isOpen; const ask = it.customers_count >= 3 ? '3+' : it.customers_count ? '1-2' : '0'; %>
          <tr id="oos-<%= it.id %>" class="<%= it.late ? 'is-late' : '' %><%= it.isOpen ? '' : ' is-closed' %>">
            <% if (canClose) { %>
              <td><% if (ed && it.answer !== 'discontinue') { %><label class="oo-tick"><input type="checkbox" name="<%= k %>[received]" value="1" aria-label="Got it: <%= it.item %>"><span><%= it.answer === 'hq_deliver' || it.answer === 'transfer' ? 'Accept' + (it.answer_qty ? ' ' + it.answer_qty : '') : it.answer === 'substitute' ? 'Sorted' : 'Back' %></span></label><% } %></td>
              <td><% if (ed) { %><label class="oo-tick is-x"><input type="checkbox" name="<%= k %>[cancel]" value="1" aria-label="Cancel: <%= it.item %>"><span>Cancel</span></label><% } %></td>
            <% } %>
            <th><b><%= it.item %></b><% if (it.product_stock_id) { %> <small class="pp-code"><%= it.product_stock_id %><%= it.product_uom ? ' · ' + it.product_uom : '' %></small><% } %>
              <% if (it.messages && it.messages.length) { %><br><a class="small<%= it.awaitingBranch ? ' oo-asked' : '' %>" href="<%= vq('cards') %>#oos-<%= it.id %>">💬 <%= it.awaitingBranch ? 'Inventory asked – reply' : it.messages.length + ' message' + (it.messages.length === 1 ? '' : 's') %></a><% } %></th>
            <td data-xf="<%= it.status %>"><%- include('partials/oos-chip', { it: it, of: of }) %></td>
            <td class="small"><%- include('partials/oos-answer-line', { it: it, of: of, at: at }) %></td>
            <td class="small" data-xf="<%= it.reported_by_name || '' %>"><%= of.when(it.reported_at, at) %><br><span class="muted"><%= it.reported_by_name || '–' %></span></td>
            <td data-xf="<%= it.left_qty === null || it.left_qty === undefined ? '' : it.left_qty %>"><% if (ed) { %><input name="<%= k %>[left]" inputmode="numeric" class="num oo-qty" value="<%= it.left_qty === null || it.left_qty === undefined ? '' : it.left_qty %>" aria-label="Left: <%= it.item %>"><% } else { %><%= it.left_qty === null || it.left_qty === undefined ? '–' : it.left_qty %><% } %></td>
            <td><% if (ed) { %><select name="<%= k %>[asking]" aria-label="Customers asking: <%= it.item %>"><% [['0', 'None'], ['1-2', '1–2'], ['3+', '3+']].forEach(function (o) { %><option value="<%= o[0] %>" <%= ask === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select><% } else { %><%= ask === '0' ? 'None' : ask === '1-2' ? '1–2' : '3+' %><% } %></td>
            <td data-xf="<%= it.urgent ? 'Urgent' : '' %>"><% if (ed) { %><input type="checkbox" name="<%= k %>[urgent]" value="1" <%= it.urgent ? 'checked' : '' %> aria-label="Urgent: <%= it.item %>"><% } else { %><%= it.urgent ? 'Urgent' : '' %><% } %></td>
            <td data-xf="<%= it.note || '' %>"><% if (ed) { %><input name="<%= k %>[note]" maxlength="200" value="<%= it.note || '' %>" placeholder="note / why cancel" aria-label="Note: <%= it.item %>"><% } else { %><span class="small"><%= it.note || '' %></span><% } %></td>
            <td class="n"><%= it.estLoss ? Math.round(it.estLoss).toLocaleString('en-MY') : '' %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <% if (canClose) { %><div class="oo-table-save"><button class="button" type="submit">Save changes</button> <span class="muted small">Tick ✔ when it arrived or ✕ to cancel (the note becomes the reason); change left / customers / urgent / note and Save. Questions &amp; photos and steps are in Cards.</span></div><% } %>
    </form>
    <% } else { %>
    <% items.forEach(function (it) { %>
      <article class="oo-item<%= it.late ? ' is-late' : '' %><%= it.isOpen ? '' : ' is-closed' %>" id="oos-<%= it.id %>">
        <header class="oo-top"><b><%= it.item %></b><%- include('partials/oos-chip', { it: it, of: of }) %></header>
        <p class="oo-line"><%- include('partials/oos-answer-line', { it: it, of: of, at: at }) %></p>
        <%- include('partials/oos-steps', { it: it, of: of, at: at }) %>
        <p class="oo-meta">Reported <%= of.when(it.reported_at, at) %> by <%= it.reported_by_name || '–' %><%= it.left_qty === 0 ? ' · none left' : it.left_qty ? ' · ' + it.left_qty + ' left' : '' %><%= it.urgent ? ' · urgent' : '' %><%= it.estLoss ? ' · ≈ RM ' + Math.round(it.estLoss).toLocaleString('en-MY') + ' sales lost' : '' %>
          <%= it.seen_at ? ' · seen by ' + (it.seen_by_name || 'Inventory') + ' ' + of.when(it.seen_at, at) : ' · not seen by Inventory yet' %><%= it.answered_at ? ' · answered ' + of.when(it.answered_at, at) : '' %><%= it.sent_at ? ' · sent ' + of.when(it.sent_at, at) : '' %><%= it.received_at ? (it.closed_by_hq ? ' · closed by Inventory ' : ' · accepted ') + of.when(it.received_at, at) : '' %></p>
        <%- include('partials/oos-thread', { it: it, action: '/oos/' + it.id + '/message', back: '/oos' + bq + '#oos-' + it.id, canTalk: canTalk, of: of, at: at, open: false }) %>
        <% if (canClose && it.isOpen) { %>
          <div class="oo-actions">
            <% const delivery = it.answer === 'hq_deliver' || it.answer === 'transfer'; %>
            <% if (it.answer !== 'discontinue') { %>
              <form method="post" action="/oos/<%= it.id %>/received"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button oo-good" type="submit"><%= delivery ? 'Accept – received' + (it.answer_qty ? ' ' + it.answer_qty : '') : it.answer === 'substitute' ? 'Done – sorted' : 'Received – back in stock' %></button></form>
            <% } %>
            <details class="oo-cancel"><summary class="link-button">Cancel – not needed any more</summary>
              <form method="post" action="/oos/<%= it.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="oo-label">Why? <small class="muted">(optional)</small><input name="reason" maxlength="200" placeholder="e.g. customer took the substitute / reported by mistake"></label>
                <button class="button secondary" type="submit">Cancel this report</button></form>
            </details>
            <% if (it.late && !it.late_flagged_at) { %>
              <form method="post" action="/oos/<%= it.id %>/late"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Tell Inventory it’s late</button></form>
            <% } else if (it.late_flagged_at) { %><span class="muted small">Inventory told it’s late <%= of.when(it.late_flagged_at, at) %></span><% } %>
          </div>
        <% } %>
      </article>
    <% }) %>
    <% } %>
  </section>
</main>
<script src="/js/photo.js?v=1" defer></script>
<script src="/js/product-pick.js?v=1" defer></script>
<script src="/js/table-filter.js?v=2" defer></script>
</body>
</html>
