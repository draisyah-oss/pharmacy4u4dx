<%- include('partials/head') %>
<%- include('partials/topbar') %>
<%- include('partials/nav', { navActive: 'requests' }) %>
<main class="page oo-page">
  <p><a href="/requests">‹ All requests</a></p>
  <% if (ok) { %><p class="alert alert-good" role="status"><%= ok %></p><% } %>
  <% if (err) { %><p class="alert alert-bad" role="alert"><%= err %></p><% } %>
  <section class="oo-card">
    <header class="oo-top"><h1>#<%= r.id %> · <%= r.title %></h1><%- include('partials/request-status', { s: r.status }) %></header>
    <p class="oo-meta"><%= r.area %> · asked by <%= r.asked_by_name || '–' %><%= r.asked_from ? ' (' + r.asked_from + ')' : '' %> · <%= of.when(r.created_at, at) %><%= r.approved_at ? ' · approved by ' + (r.approved_by_name || '–') + ' ' + of.when(r.approved_at, at) : '' %><%= r.live_at ? ' · live ' + of.when(r.live_at, at) : '' %></p>
    <% if (r.details) { %><p class="oo-note"><%= r.details %></p><% } %>
    <% if (r.photo_id) { %><p class="oo-msg-photo"><a href="/oos/photo/<%= r.photo_id %>" target="_blank" rel="noopener"><img src="/oos/photo/<%= r.photo_id %>" alt="Screenshot" loading="lazy"></a></p><% } %>
    <ol class="oo-steps" aria-label="Progress">
      <% const idx = r.status === 'Live' ? 3 : r.approved_at && r.status !== 'Not doing' ? 2 : 0;
         [['Asked', 0], ['Dr Aisyah approves', 1], ['Mr 4DX makes the change', 2], ['Live', 3]].forEach(function (st) { const done = r.status !== 'Not doing' && st[1] <= idx; %>
        <li class="<%= done ? 'is-done' : '' %><%= st[1] === idx + 1 && r.status !== 'Not doing' ? ' is-current' : '' %>"><span class="oo-dot" aria-hidden="true"><%= done ? '✔' : '' %></span><span class="oo-step-l"><%= st[0] %></span></li>
      <% }) %>
    </ol>
    <% if (r.status === 'Need more info') { %><p class="alert alert-info">Mr 4DX has a question – answer it in the conversation below and it goes back to <%= r.approved_at ? 'Mr 4DX' : 'Dr Aisyah' %>.</p><% } %>
    <% if (r.status === 'Approved') { %><p class="muted small">Approved – Mr 4DX checks for approved changes every 2 hours (8 am – 10 pm, every day), makes the change, tests it and marks it Live here.</p><% } %>
  </section>

  <% if (r.plan) { %><section class="oo-card"><h2>Mr 4DX’s plan</h2><p class="pre-wrap"><%= r.plan %></p></section><% } %>

  <% if (can.approve || can.reject) { %>
    <form method="post" action="/requests/<%= r.id %>/act" class="oo-card oo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Your decision</h2>
      <label class="oo-label">Note for Mr 4DX (optional)<input name="message" maxlength="1500" autocomplete="off" placeholder="e.g. target 2 a day, BR only"></label>
      <div class="oo-two"><% if (can.approve) { %><button class="button oo-good" name="action" value="approve">✔ Approve – Mr 4DX makes it</button><% } %><% if (can.reject) { %><button class="button secondary" name="action" value="reject">Not doing</button><% } %></div>
    </form>
  <% } %>

  <section class="oo-card" aria-labelledby="th-h">
    <h2 id="th-h">Conversation</h2>
    <ol class="oo-msgs">
      <% r.notes.forEach(function (n) { %>
        <li class="oo-msg<%= n.author ? ' is-hq' : ' is-branch' %>"><span class="oo-msg-who"><b><%= n.who || '–' %></b> · <%= of.when(n.created_at, at) %></span><span class="oo-msg-body"><%= n.body %></span></li>
      <% }) %>
    </ol>
    <% if (!r.notes.length) { %><p class="muted small">No messages yet.</p><% } %>
    <form method="post" action="/requests/<%= r.id %>/note" class="oo-msg-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <textarea name="message" rows="2" maxlength="1500" placeholder="Add a detail or answer a question"></textarea>
      <button class="button secondary" type="submit">Send</button>
    </form>
  </section>

</main>
</body>
</html>
